@{
    ViewData["Title"] = "Learn cybersecurity";
    ViewData["PageClass"] = "home-landing";
    ViewData["ThemeColor"] = "#f2fbf7";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
<section class="landing-hero" aria-labelledby="home-title">
    <div class="landing-hero-inner">
        <div class="landing-hero-copy">
            <h1 id="home-title">Learn cybersecurity.<br /><span>Put it into practice.</span></h1>
            <p>Study teacher-led lessons, solve security challenges and practise commands in a simulated terminal.</p>
            <div class="landing-actions">
                <a class="btn landing-button-main" asp-controller="Account" asp-action="Register">Start learning</a>
                <a class="btn landing-button-secondary" asp-controller="Account" asp-action="Login">Log in</a>
            </div>
        </div>
        <img class="landing-student" src="~/images/home-student.png" asp-append-version="true" width="1142" height="1377" fetchpriority="high" alt="A student working on a laptop" />
        <aside class="landing-preview" aria-labelledby="preview-title">
            <div class="preview-brand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Zm0 0v15"/></svg><span>HackAcad</span></div>
            <h2 id="preview-title">Your learning space</h2>
            <ul>
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><div><strong>Courses &amp; lessons</strong><span>Build your understanding</span></div></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><div><strong>CTF challenges</strong><span>Work through a problem</span></div></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><div><strong>Terminal practice</strong><span>Try commands for yourself</span></div></li>
            </ul>
            <p>One account for your learning activity.</p>
        </aside>
    </div>
</section>
<section class="landing-formats" id="learning-experience" aria-label="Learning on HackAcad">
    <div class="container landing-formats-inner">
        <div><h2>Learn the foundations</h2><p>Lessons organised by topic, created by your teachers.</p></div>
        <div><h2>Work through a challenge</h2><p>Apply what you know and submit your answer.</p></div>
        <div><h2>Practise in your browser</h2><p>Explore commands in a simulated terminal.</p></div>
    </div>
</section>
<section class="container landing-practice" aria-labelledby="practice-title">
    <div class="landing-practice-copy"><h2 id="practice-title">More than reading<br />through a lesson.</h2><p>Use the course material as a starting point. Then put the ideas to work through a challenge or a terminal exercise.</p><p>Your dashboard keeps your course enrolments and learning activity together.</p><a class="landing-text-link" href="#getting-started">Getting started with HackAcad <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>
    <figure class="landing-terminal"><figcaption><span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>Example terminal exercise</figcaption><div class="terminal-content"><p class="terminal-question">Find the current working directory.</p><pre><code><span class="terminal-prompt">student@hackacad:~$</span> pwd
/home/student

<span class="terminal-prompt">student@hackacad:~$</span> ls
notes.txt  exercises  resources</code></pre><p class="terminal-caption">Read the output. Understand what the command does.</p></div></figure>
</section>
<section class="landing-teaching" id="for-teachers" aria-labelledby="teaching-title"><div class="container landing-teaching-inner"><div><h2 id="teaching-title">Have something to teach?</h2><p>Create an account, then ask an administrator for Teacher access.</p></div><a class="btn landing-button-secondary" asp-controller="Account" asp-action="Register">Join HackAcad</a></div></section>
<section class="container landing-faq" id="getting-started" aria-labelledby="faq-title"><div><h2 id="faq-title">Before you get started</h2><p>A few things to know about your account.</p></div><div class="landing-questions">
    <details><summary>What access do I get when I sign up?</summary><p>Public registration creates a Student account. Administrators can grant Teacher or Admin access.</p></details>
    <details><summary>Where can I see my learning activity?</summary><p>Your dashboard shows your course enrolments, completed activities and solved challenges.</p></details>
    <details><summary>Can I change my profile and password?</summary><p>Yes. After logging in, open My profile to update your username or change your password.</p></details>
</div></section>
