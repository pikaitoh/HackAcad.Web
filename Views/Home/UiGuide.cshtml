@{ ViewData["Title"] = "UI guide"; }
<div class="container module-shell">
    <div class="page-heading"><div><h1>HackAcad UI guide</h1><p class="text-secondary">Shared components for the team. Development preview.</p></div></div>
    <section class="mb-5"><h2>Actions &amp; states</h2><p class="text-secondary">One primary action per section. Use labels alongside status colours.</p><div class="form-actions mb-4"><button class="btn btn-primary" type="button">Primary action</button><button class="btn btn-outline-secondary" type="button">Secondary action</button><button class="btn btn-danger" type="button">Delete</button><button class="btn btn-primary" type="button" disabled>Unavailable</button></div><div class="d-flex flex-wrap gap-3"><span class="role-badge" data-role="Admin">Admin</span><span class="role-badge" data-role="Teacher">Teacher</span><span class="role-badge" data-role="Student">Student</span><span class="status-label status-active">Active</span><span class="status-label status-disabled">Disabled</span></div></section>
    <section class="mb-5"><h2>Form fields</h2><p class="text-secondary">Persistent labels, useful help text and a specific error.</p><div class="form-measure"><div class="mb-4"><label for="guide-name" class="form-label">Username</label><input id="guide-name" class="form-control" placeholder="e.g. Alex Tan" aria-describedby="guide-name-help" /><div id="guide-name-help" class="form-text">Use a name your classmates can recognise.</div></div><label for="guide-email" class="form-label">Email</label><input id="guide-email" type="email" class="form-control input-validation-error" value="alex" aria-invalid="true" aria-describedby="guide-email-error" /><span class="field-error" id="guide-email-error">Enter a valid email address.</span></div></section>
    <section class="mb-5" aria-labelledby="learning-patterns-title"><h2 id="learning-patterns-title">Course, outline &amp; progress patterns</h2><p class="guide-example-note">Design example only. The course, lesson titles and progress below are illustrative, not records from your account. Module owners supply real content, counts and working course actions.</p>
        <div class="guide-learning"><article class="course-preview"><span class="role-badge">Web security</span><h3>Web security foundations</h3><p>Understand how a browser communicates with a web application, then apply the concepts through practice.</p><div class="course-metadata"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Zm0 0v15"/></svg>8 lessons</span><span>Teacher: Alex Tan</span></div><div class="learning-progress"><div><label for="guide-progress">Illustrative progress</label><span>3 of 8 lessons</span></div><progress id="guide-progress" value="3" max="8">3 of 8 lessons</progress></div></article>
        <div class="learning-outline"><details open><summary><span><strong>HTTP foundations</strong><span>Lesson overview</span></span></summary><div class="outline-content"><p>Explain the request-and-response cycle between a browser and a server.</p><dl class="outcome-list"><div><dt>Learning goal</dt><dd>Identify the parts of an HTTP request.</dd></div></dl></div></details><details><summary><span><strong>Apply the concept</strong><span>Practice overview</span></span></summary><div class="outline-content"><p>Inspect an example request and identify the method, path and headers.</p></div></details></div></div>
    </section>
    <section><h2>Empty state</h2><div class="empty-state"><h3>No courses found</h3><p>Try another title or clear your filters.</p><a asp-controller="Home" asp-action="UiGuide">Clear filters</a></div></section>
</div>
