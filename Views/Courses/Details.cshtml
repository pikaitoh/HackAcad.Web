@model CourseDetailsViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="container module-shell">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to Catalogue</a>
    </div>

    <!-- Course Hero Header -->
    <div class="workspace-start mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div style="max-width: 48rem;">
                <span class="badge mb-2" style="background:#f2cf45; color:#193e46; font-weight:700;">@(Model.Course.Category ?? "Cybersecurity")</span>
                <h1 style="color:white; font-size:2.25rem; font-weight:800; margin-bottom:0.75rem;">@Model.Course.Title</h1>
                <p style="color:var(--ha-on-dark); font-size:1rem; line-height:1.6; margin-bottom:1.25rem;">
                    @(Model.Course.Description ?? "Hands-on guided cybersecurity training path with theoretical lessons, downloadable CTF challenges, and real-time terminal labs.")
                </p>
                <div style="color:var(--ha-on-dark); font-size:0.875rem;">
                    <span>Created by <strong>@Model.TeacherName</strong></span>
                    <span class="mx-2">•</span>
                    <span>@Model.Lessons.Count Lessons</span>
                    <span class="mx-2">•</span>
                    <span>@Model.Challenges.Count CTF Challenges</span>
                    <span class="mx-2">•</span>
                    <span>@Model.SimulationTasks.Count Terminal Labs</span>
                </div>
            </div>

            <!-- Action Panel -->
            <div class="surface-panel p-4" style="min-width: 18rem; border-radius: 12px;">
                @if (Model.IsEnrolled)
                {
                    <div class="learning-progress mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">Your Course Progress</span>
                            <strong>@Model.ProgressPercent%</strong>
                        </div>
                        <progress value="@Model.ProgressPercent" max="100"></progress>
                    </div>
                    <a asp-action="Learn" asp-route-id="@Model.Course.CourseId" asp-route-lessonId="@Model.ResumeLessonId" class="btn btn-primary w-100 btn-lg">
                        Continue Learning →
                    </a>
                }
                else if (User.IsInRole(AccountRoles.Student))
                {
                    <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Free Enrolment</h3>
                    <p class="text-secondary small mb-3">Instant self-paced access. Progress automatically saved as you learn.</p>
                    <form asp-action="Enroll" asp-route-id="@Model.Course.CourseId" method="post">
                        <button type="submit" class="btn btn-primary w-100 btn-lg">Enrol Now</button>
                    </form>
                }
                else if (signedIn)
                {
                    <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Course preview</h3>
                    <a asp-controller="TeacherCourses" asp-action="Index" class="btn btn-outline-secondary w-100">Back to Teacher Studio</a>
                }
                else
                {
                    <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Start Learning Today</h3>
                    <p class="text-secondary small mb-3">Sign in or register an account to enrol and track your achievements.</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Courses", new { id = Model.Course.CourseId })" class="btn btn-primary w-100">
                        Log in to Enrol
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Curriculum Breakdown -->
    <div class="surface-panel p-4 mb-4">
        <h2 style="font-size: 1.35rem; font-weight:700; margin-bottom:1.25rem;">Course Curriculum</h2>

        <!-- Module 1: Lessons -->
        <div class="mb-4">
            <h3 style="font-size: 1.05rem; font-weight:700; color:var(--ha-primary); margin-bottom: 0.75rem;">
                📚 Guided Lessons (@Model.Lessons.Count)
            </h3>
            @if (Model.Lessons.Count == 0)
            {
                <p class="text-secondary small">No lessons published yet in this course.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var l in Model.Lessons)
                    {
                        var isDone = Model.CompletedLessonIds.Contains(l.LessonId);
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @(isDone ? "bg-success" : "bg-light text-dark")" style="font-size:0.85rem; width:2rem; text-align:center;">
                                    @(isDone ? "✓" : l.OrderIndex.ToString())
                                </span>
                                <div>
                                    <strong style="font-size:0.95rem;">@l.Title</strong>
                                    @if (!string.IsNullOrEmpty(l.VideoUrl))
                                    {
                                        <span class="badge bg-secondary ms-2 small">Video Included</span>
                                    }
                                </div>
                            </div>
                            @if (Model.IsEnrolled)
                            {
                                <a asp-action="Learn" asp-route-id="@Model.Course.CourseId" asp-route-lessonId="@l.LessonId" class="btn btn-sm btn-outline-secondary">
                                    @(isDone ? "Review" : "Start")
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Module 2: CTF Challenges -->
        @if (Model.Challenges.Any())
        {
            <div class="mb-4">
                <h3 style="font-size: 1.05rem; font-weight:700; color:#b12e3f; margin-bottom: 0.75rem;">
                    🚩 CTF Challenges (@Model.Challenges.Count)
                </h3>
                <div class="list-group">
                    @foreach (var ch in Model.Challenges)
                    {
                        var isDone = Model.CompletedChallengeIds.Contains(ch.ChallengeId);
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <strong style="font-size:0.95rem;">@ch.Title</strong>
                                    <span class="difficulty-badge diff-@(ch.Difficulty?.ToLowerInvariant() ?? "easy")">@ch.Difficulty</span>
                                    <span class="points-pill">+@ch.Points pts</span>
                                    @if (isDone)
                                    {
                                        <span class="badge bg-success ms-1">Solved ✓</span>
                                    }
                                </div>
                                <div class="text-secondary small">@(ch.Description ?? "Examine question resources and uncover the secret flag.")</div>
                            </div>
                            @if (Model.IsEnrolled)
                            {
                                <a asp-action="Learn" asp-route-id="@Model.Course.CourseId" asp-route-challengeId="@ch.ChallengeId" class="btn btn-sm btn-outline-secondary">
                                    @(isDone ? "View Solved" : "Attempt CTF")
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Module 3: Simulation Tasks -->
        @if (Model.SimulationTasks.Any())
        {
            <div class="mb-3">
                <h3 style="font-size: 1.05rem; font-weight:700; color:#0284c7; margin-bottom: 0.75rem;">
                    💻 Hands-on Terminal Labs (@Model.SimulationTasks.Count)
                </h3>
                <div class="list-group">
                    @foreach (var s in Model.SimulationTasks)
                    {
                        var isDone = Model.CompletedSimulationIds.Contains(s.TaskId);
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <strong style="font-size:0.95rem;">@s.Title</strong>
                                    <span class="badge bg-info text-dark">Simulated Shell</span>
                                    @if (isDone)
                                    {
                                        <span class="badge bg-success ms-1">Completed ✓</span>
                                    }
                                </div>
                                <div class="text-secondary small">@(s.Instructions ?? "Execute lab tasks in a safe client-side sandbox.")</div>
                            </div>
                            @if (Model.IsEnrolled)
                            {
                                <a asp-action="Learn" asp-route-id="@Model.Course.CourseId" asp-route-simulationId="@s.TaskId" class="btn btn-sm btn-outline-secondary">
                                    @(isDone ? "Launch Lab Again" : "Launch Lab")
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
