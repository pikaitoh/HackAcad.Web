@model CourseCreateEditModel
@{
    var isEdit = Model.CourseId > 0;
    ViewData["Title"] = isEdit ? "Edit Course" : "Create Course";
}

<div class="container module-shell">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to Teacher Studio</a>
    </div>

    <div class="page-heading">
        <div>
            <h1>@(isEdit ? "Edit Course Settings" : "Create New Course")</h1>
            <p class="text-secondary">Provide title, domain category, description, and catalogue thumbnail.</p>
        </div>
    </div>

    <div class="surface-panel p-4" style="max-width: 44rem;">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" data-validated-form>
            @if (isEdit)
            {
                <input type="hidden" asp-for="CourseId" />
            }

            <div asp-validation-summary="ModelOnly" class="validation-summary mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Course Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Linux Command Line Fundamentals & Security" required maxlength="150" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Domain / Category</label>
                <select asp-for="Category" class="form-select">
                    <option value="Web Security">Web Security</option>
                    <option value="Linux Basics">Linux Basics</option>
                    <option value="Cryptography">Cryptography</option>
                    <option value="Network Security">Network Security</option>
                    <option value="Digital Forensics">Digital Forensics</option>
                    <option value="Reverse Engineering">Reverse Engineering</option>
                    <option value="General Security">General Security</option>
                </select>
                <span asp-validation-for="Category" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Course Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Summarize what learners will achieve, prerequisites, and learning outcomes..."></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ThumbnailUrl" class="form-label">Thumbnail URL (Optional)</label>
                <input asp-for="ThumbnailUrl" class="form-control" placeholder="https://example.com/thumb.jpg or leave blank for cyber shield" />
                <div class="form-text">Direct image link for course card thumbnail. Leave empty to display standard cybersecurity badge.</div>
                <span asp-validation-for="ThumbnailUrl" class="field-error"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedCheck" />
                <label class="form-check-label" for="isPublishedCheck">
                    <strong>Publish immediately to catalogue</strong> (Visible to all students and visitors)
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    @(isEdit ? "Save Course Settings" : "Create Course & Continue to Curriculum →")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
