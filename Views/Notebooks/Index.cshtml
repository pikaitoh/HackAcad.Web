@model List<NotebookListItemViewModel>
@inject HackAcad.Web.Services.UserTimeZone UserTime
@{
    ViewData["Title"] = "Terminal Notebooks";
}

<div class="container module-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="mb-1">Terminal Notebooks</h1>
            <p class="text-secondary mb-0">Create personal interactive notebooks combining Markdown notes and simulated Linux terminal sandboxes.</p>
        </div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                + New Notebook
            </button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="surface-panel p-5 text-center empty-state border rounded-3">
            <div class="mb-3 text-secondary">
                <img src="/images/notebook.svg" class="sim-icon" alt="" style="width: 48px; height: 48px; opacity: 0.6;" />
            </div>
            <h2 class="h4 mb-2">No Notebooks Created Yet</h2>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 520px;">
                Notebooks allow you to write formatted study notes, include static terminal examples, and practice directly in live simulated Linux environments.
            </p>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary px-4 py-2">
                    Create Your First Notebook
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var nb in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="surface-panel p-4 h-100 d-flex flex-column justify-content-between border rounded-3 shadow-sm hover-shadow transition">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary-subtle text-secondary border font-monospace small">NOTEBOOK</span>
                                <span class="text-secondary small" title="Updated @nb.UpdatedAtUtc.ToString("u")">
                                    @UserTime.Format(nb.UpdatedAtUtc)
                                </span>
                            </div>
                            <h2 class="h5 mb-3 text-truncate" title="@nb.Title">
                                <a asp-action="View" asp-route-id="@nb.NotebookId" class="text-decoration-none" style="color:var(--ha-ink);">
                                    @nb.Title
                                </a>
                            </h2>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (nb.MarkdownBlockCount > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border d-inline-flex align-items-center">
                                        <img src="/images/edit.svg" class="sim-icon me-1" alt="" style="width:13px;height:13px;" />
                                        @nb.MarkdownBlockCount @(nb.MarkdownBlockCount == 1 ? "Note" : "Notes")
                                    </span>
                                }
                                @if (nb.InteractiveTerminalCount > 0)
                                {
                                    <span class="badge bg-info-subtle text-info border d-inline-flex align-items-center">
                                        <img src="/images/terminal.svg" class="sim-icon me-1" alt="" style="width:13px;height:13px;" />
                                        @nb.InteractiveTerminalCount @(nb.InteractiveTerminalCount == 1 ? "Interactive CLI" : "Interactive CLIs")
                                    </span>
                                }
                                @if (nb.StaticExampleCount > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border d-inline-flex align-items-center">
                                        <img src="/images/clipboard.svg" class="sim-icon me-1" alt="" style="width:13px;height:13px;" />
                                        @nb.StaticExampleCount @(nb.StaticExampleCount == 1 ? "Example" : "Examples")
                                    </span>
                                }
                                @if (nb.MarkdownBlockCount == 0 && nb.InteractiveTerminalCount == 0 && nb.StaticExampleCount == 0)
                                {
                                    <span class="badge bg-secondary-subtle text-muted border">Empty Draft</span>
                                }
                            </div>
                        </div>

                        <div class="pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex gap-2">
                                <a asp-action="View" asp-route-id="@nb.NotebookId" class="btn btn-sm btn-outline-secondary" title="View notebook notes and run terminal">
                                    Open
                                </a>
                                <a asp-action="Edit" asp-route-id="@nb.NotebookId" class="btn btn-sm btn-primary" title="Edit content, Markdown and terminal blocks">
                                    Edit
                                </a>
                            </div>
                            <div class="d-flex gap-1">
                                <a asp-action="Export" asp-route-id="@nb.NotebookId" class="btn btn-sm btn-outline-secondary" title="Download standalone offline HTML file">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px;" aria-hidden="true">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                    HTML
                                </a>
                                <form asp-action="Delete" asp-route-id="@nb.NotebookId" method="post" onsubmit="return confirm('Are you sure you want to delete this notebook?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete notebook">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px;" aria-hidden="true">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
