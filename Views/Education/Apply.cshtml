@model InstructorApplicationInput
@{ ViewData["Title"] = "Instructor application"; }
<div class="container education-section application-measure"><div class="page-heading"><div><h1>Apply to become an Instructor</h1><p class="text-secondary">Provide at least five years of relevant teaching history and evidence an administrator can verify.</p></div></div>
<form asp-action="Apply" method="post" enctype="multipart/form-data" class="surface-panel application-form" data-experience-form data-validated-form novalidate>
<p class="form-text">Fields marked with an asterisk (*) are required.</p>
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="education-two-fields"><div><label asp-for="FullName" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="FullName" type="text" class="form-control" maxlength="100" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.FullName))-error" /><span id="@(Html.IdFor(m => m.FullName))-error" asp-validation-for="FullName" class="field-error" aria-live="polite"></span></div><div><label asp-for="WorkEmail" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="WorkEmail" type="email" class="form-control" maxlength="256" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.WorkEmail))-error" /><span id="@(Html.IdFor(m => m.WorkEmail))-error" asp-validation-for="WorkEmail" class="field-error" aria-live="polite"></span></div></div>
<div class="mb-4"><div><label asp-for="TeachingTopics" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="TeachingTopics" minlength="10" type="text" class="form-control" maxlength="200" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.TeachingTopics))-error" /><p class="form-text">Describe your teaching topics in 10–200 characters, for example: network security and Linux fundamentals.</p><span id="@(Html.IdFor(m => m.TeachingTopics))-error" asp-validation-for="TeachingTopics" class="field-error" aria-live="polite"></span></div></div>
<h2 class="h5">Teaching experience</h2><p class="form-text">List each institution and role. Leave the end date empty if you still work there. Overlapping periods count once.</p>
<div data-experience-rows>
@for (var i = 0; i < Model.Experience.Count; i++) {
<fieldset class="experience-row" data-experience-row><legend>Teaching role @(i + 1)</legend><div class="education-two-fields"><div><label asp-for="Experience[i].Institution" class="form-label">Institution <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Experience[i].Institution" type="text" class="form-control" maxlength="150" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.Experience[i].Institution))-error" /><span id="@(Html.IdFor(m => m.Experience[i].Institution))-error" asp-validation-for="Experience[i].Institution" class="field-error" aria-live="polite"></span></div><div><label asp-for="Experience[i].Position" class="form-label">Position <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Experience[i].Position" type="text" class="form-control" maxlength="100" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.Experience[i].Position))-error" /><span id="@(Html.IdFor(m => m.Experience[i].Position))-error" asp-validation-for="Experience[i].Position" class="field-error" aria-live="polite"></span></div></div><div class="mb-3"><div><label asp-for="Experience[i].Subjects" class="form-label">Subjects taught <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Experience[i].Subjects" minlength="10" type="text" class="form-control" maxlength="200" required aria-required="true" data-trim aria-describedby="@(Html.IdFor(m => m.Experience[i].Subjects))-error" /><p class="form-text">Describe the subjects you taught in 10–200 characters.</p><span id="@(Html.IdFor(m => m.Experience[i].Subjects))-error" asp-validation-for="Experience[i].Subjects" class="field-error" aria-live="polite"></span></div></div><div class="education-two-fields"><div><label asp-for="Experience[i].StartDate" class="form-label">Start date <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Experience[i].StartDate" type="date" class="form-control" required aria-required="true" data-trim min="1950-01-01" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" aria-describedby="@(Html.IdFor(m => m.Experience[i].StartDate))-error" /><span id="@(Html.IdFor(m => m.Experience[i].StartDate))-error" asp-validation-for="Experience[i].StartDate" class="field-error" aria-live="polite"></span></div><div><label asp-for="Experience[i].EndDate" class="form-label">End date (optional)</label><input asp-for="Experience[i].EndDate" type="date" class="form-control" min="1950-01-01" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" aria-describedby="@(Html.IdFor(m => m.Experience[i].EndDate))-error" /><span id="@(Html.IdFor(m => m.Experience[i].EndDate))-error" asp-validation-for="Experience[i].EndDate" class="field-error" aria-live="polite"></span></div></div><button type="button" class="btn btn-outline-secondary btn-sm" data-remove-experience>Remove role</button></fieldset>
}</div>
<span asp-validation-for="Experience" class="field-error" id="experience-error" aria-live="polite"></span>
<button type="button" class="btn btn-outline-secondary mb-4" data-add-experience>Add another teaching role</button>
<div class="mb-4"><label asp-for="Evidence" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="Evidence" type="file" accept="application/pdf,.pdf" class="form-control" required aria-required="true" data-val="true" data-val-required="Upload your teaching experience evidence." data-file-max-size="5242880" data-file-kind="pdf" aria-describedby="Evidence-help Evidence-error" /><p class="form-text" id="Evidence-help">Upload one PDF confirming your teaching roles and employment dates. Up to 5 MB. Only you and administrators can download it. A revised application needs a fresh upload.</p><span id="Evidence-error" asp-validation-for="Evidence" class="field-error" aria-live="polite"></span></div>
<div class="mb-4"><label asp-for="SupportingInformation" class="form-label"></label><textarea asp-for="SupportingInformation" class="form-control" rows="4" maxlength="3000" aria-describedby="SupportingInformation-error"></textarea><span id="SupportingInformation-error" asp-validation-for="SupportingInformation" class="field-error" aria-live="polite"></span></div>
<div class="mb-4"><label asp-for="SubmissionNote" class="form-label"></label><textarea asp-for="SubmissionNote" class="form-control" rows="3" maxlength="2000" aria-describedby="SubmissionNote-error"></textarea><span id="SubmissionNote-error" asp-validation-for="SubmissionNote" class="field-error" aria-live="polite"></span></div>
<div class="form-check mb-4"><input asp-for="Declaration" class="form-check-input" required aria-required="true" aria-describedby="Declaration-error" /><label asp-for="Declaration" class="form-check-label">I confirm that my teaching history and supporting evidence are accurate. <span class="required-mark" aria-hidden="true">*</span></label><span id="Declaration-error" asp-validation-for="Declaration" class="field-error" aria-live="polite"></span></div>
<div class="form-actions"><button class="btn btn-primary" type="submit">Submit application</button><a asp-action="Index">Back to For Education</a></div>
</form></div>
@section Scripts { <script src="~/js/education.js" asp-append-version="true" defer></script> }
