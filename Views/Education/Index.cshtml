@{ ViewData["Title"] = "For Education"; }
<section class="education-hero"><div class="container education-hero-grid"><div><h1>Turn your teaching experience into someone's next skill.</h1><p>Bring cybersecurity, computing and IT lessons to life with courses, CTF challenges and simulated terminal labs on HackAcad.</p><a class="btn btn-primary" href="#instructor-requirements">Explore Instructor requirements</a></div><div class="education-outline"><h2>Your teaching, in one workspace.</h2><ul><li><strong>Build a course</strong><span>Organise lessons around clear learning goals.</span></li><li><strong>Create practical challenges</strong><span>Help learners investigate evidence and apply concepts.</span></li><li><strong>Follow student progress</strong><span>Review enrolments and learning activity in your courses.</span></li></ul></div></div></section>
<section class="container education-section" id="instructor-requirements"><div class="page-heading"><div><h2>Who can become an Instructor?</h2><p class="text-secondary">All public registrations start as Student accounts. Instructor access requires an application and administrator approval.</p></div></div><div class="education-columns"><div><h3>At least five years of relevant teaching</h3><p>Include your teaching institutions, positions, subjects and dates. Experience must relate to cybersecurity, computer science or IT and the topics you want to teach. Overlapping roles count only once.</p><h3>Evidence an administrator can verify</h3><p>Provide a PDF evidence pack, such as appointment or service letters and verifiable institutional staff-profile references. A work email or certificate alone does not guarantee approval.</p><h3>Supporting information is optional</h3><p>You may include qualifications, project links and a short teaching sample. These help the review but do not replace the five-year teaching requirement.</p></div><aside class="surface-panel"><h3>A review you can follow</h3><ol class="education-review-steps"><li>Register or log in to your Student account.</li><li>Submit your teaching history and evidence.</li><li>An administrator checks the same eligibility requirements for every applicant.</li><li>View the decision and reason. Supply more information or request reconsideration through a revised application.</li></ol><p class="form-text">Your account stays Student while the review is pending. Approval unlocks Instructor access; your existing account and learning records are preserved.</p>
@if (User.IsInRole(AccountRoles.Student)) { <div class="form-actions"><a class="btn btn-primary" asp-action="Apply">Apply to become an Instructor</a><a asp-action="Status">View my application</a></div> }
else if (User.Identity?.IsAuthenticated != true) { <div class="form-actions"><a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create a Student account</a><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Apply", "Education")">Log in to apply</a></div> }
else if (User.IsInRole(AccountRoles.Instructor)) { <p>You already have Instructor access.</p><a class="btn btn-primary" asp-controller="InstructorCourses" asp-action="Index">Open Instructor Studio</a> }
else { <a class="btn btn-primary" asp-controller="Admin" asp-action="Applications">Review Instructor applications</a> }
</aside></div></section>
