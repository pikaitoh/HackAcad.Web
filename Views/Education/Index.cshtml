@{ ViewData["Title"] = "For Education"; var hasApplication = ViewData["HasApplication"] as bool? == true; }
<section class="education-hero"><div class="container education-hero-grid"><div><h1>Turn your teaching experience into someone's next skill.</h1><p>Bring cybersecurity, computing and IT lessons to life with courses, CTF challenges and simulated terminal labs on HackAcad.</p><a class="btn btn-primary" href="#instructor-requirements">Explore Instructor requirements</a></div><div class="education-outline"><h2>Your teaching, in one workspace.</h2><ul><li><strong>Build a course</strong><span>Organise lessons around clear learning goals.</span></li><li><strong>Create practical challenges</strong><span>Help learners investigate evidence and apply concepts.</span></li><li><strong>Follow student progress</strong><span>Review enrolments and learning activity in your courses.</span></li></ul></div></div></section>
<section class="container education-section" id="instructor-requirements">
<h2>Instructor requirements</h2><p class="text-secondary">Start with a Student account. Instructor access requires an application and administrator approval.</p>
<dl class="education-requirements">
<div><dt>At least five years of relevant teaching</dt><dd>List where you taught, your positions, subjects and employment dates. Teaching must relate to cybersecurity, computer science or IT and your proposed topics. Overlapping periods count once.</dd></div>
<div><dt>Evidence of your teaching experience</dt><dd>Upload a PDF with documents confirming your teaching role and employment dates, such as a letter from your school or employer. You may also include links to your staff profile on the institution's official website.</dd></div>
<div><dt>Optional supporting information</dt><dd>Qualifications, project links and a short teaching sample can support your application. They do not replace the five-year teaching requirement.</dd></div>
</dl>
<section class="education-apply-steps" aria-labelledby="apply-heading"><h2 id="apply-heading">How to apply</h2><ol><li><strong>Use your Student account</strong><p>Register or log in before applying.</p></li><li><strong>Submit your experience</strong><p>Provide your teaching history and evidence.</p></li><li><strong>Administrator review</strong><p>Your evidence is checked against the eligibility requirements.</p></li><li><strong>View your decision</strong><p>Read the review, or supply more information through a revised application.</p></li></ol>
<p class="form-text">You remain a Student during review. Approval unlocks Instructor access and preserves your existing account and learning records.</p>
<div class="form-actions">
@if (User.IsInRole(AccountRoles.Student)) {
    @if (hasApplication) { <a class="btn btn-primary" asp-action="Status">View my application</a> }
    else { <a class="btn btn-primary" asp-action="Apply">Apply to become an Instructor</a> }
} else if (User.Identity?.IsAuthenticated != true) { <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create a Student account</a><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Apply", "Education")">Log in to apply</a> }
else if (User.IsInRole(AccountRoles.Instructor)) { <a asp-controller="InstructorCourses" asp-action="Index">Back to Instructor Studio</a> }
else { <a asp-controller="Admin" asp-action="Applications">Review Instructor applications</a> }
</div></section></section>
