@{ Layout = "_Layout"; }
<div class="auth-layout container">
    <aside class="auth-aside">
        <a class="text-decoration-none fw-semibold" asp-controller="Home" asp-action="Index">Back to HackAcad</a>
        <h2>One account.<br />Room to keep learning.</h2>
        <p>Work through cybersecurity lessons, practise your skills and keep your learning progress in one place.</p>
        <p class="auth-note">New accounts start as Students. An administrator can grant Teacher access when you are ready to create courses.</p>
    </aside>
    <section class="auth-form" aria-labelledby="auth-title">
        @RenderBody()
    </section>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
