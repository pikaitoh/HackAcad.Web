@{ Layout = "_Layout"; }
<div class="auth-layout container">
    <aside class="auth-aside">
        <h2>Build skills.<br />Keep your progress.</h2>
        <p>A place to learn cybersecurity, put it into practice and see how far you have come.</p>
        <ol class="learning-path">
            <li><span class="path-marker" aria-hidden="true">1</span><div><strong>Learn the foundations</strong><span>Follow instructor-led courses.</span></div></li>
            <li><span class="path-marker" aria-hidden="true">2</span><div><strong>Put them into practice</strong><span>Work through challenges and simulations.</span></div></li>
            <li><span class="path-marker" aria-hidden="true">3</span><div><strong>Keep moving forward</strong><span>Return to your learning progress.</span></div></li>
        </ol>
        <p class="auth-note">Want to teach? Create a Student account, then apply through <a asp-controller="Education" asp-action="Index">For Education</a>.</p>
    </aside>
    <section class="auth-form" aria-labelledby="auth-title">@RenderBody()</section>
</div>
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
