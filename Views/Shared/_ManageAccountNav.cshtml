@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var section = action switch
    {
        "ChangeEmail" or "Settings" => "Settings",
        "SendPhoneCode" or "VerifyPhone" or "RemovePhone" or "CancelPhoneVerification" or "PhoneNumber" => "PhoneNumber",
        "BeginAuthenticator" or "EnableAuthenticator" or "ManageTwoFactor" or "TwoFactor" => "TwoFactor",
        _ => action
    };
    var links = new[] {
        (Action: "Settings", Label: "Email address", Icon: "M3 5h18v14H3Zm0 0 9 7 9-7"),
        (Action: "PhoneNumber", Label: "Phone number", Icon: "M7 2h10v20H7Zm4 17h2"),
        (Action: "ChangePassword", Label: "Password", Icon: "M6 10h12v11H6Zm3 0V6a3 3 0 0 1 6 0v4m-3 5v2"),
        (Action: "TwoFactor", Label: "Two-factor authentication", Icon: "m12 3 8 4v5c0 5-8 9-8 9s-8-4-8-9V7Zm-4 9 3 3 5-6"),
        (Action: "LoginHistory", Label: "Login history", Icon: "M3 12a9 9 0 1 0 3-6M3 3v5h5m4-1v5l3 2"),
        (Action: "Sessions", Label: "Devices & sessions", Icon: "M2 4h15v12H2Zm3 16h9m-5-4v4m11-10h3v11h-6v-2")
    };
}
<nav class="account-settings-nav" aria-label="Manage account">
    @foreach (var item in links)
    {
        <a asp-controller="Account" asp-action="@item.Action" aria-current="@(section == item.Action ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg><span>@item.Label</span></a>
    }
</nav>
