@model ApplicationDetailsModel
<section class="surface-panel mb-4"><div class="section-heading"><h2>Submission @Model.Application.Revision</h2><span class="role-badge">@Model.Application.Status</span></div>
<dl class="application-details"><div><dt>Applicant</dt><dd>@Model.Application.FullName<span class="record-secondary">@Model.ApplicantEmail</span></dd></div><div><dt>Professional email</dt><dd>@Model.Application.WorkEmail</dd></div><div><dt>Teaching topics</dt><dd>@Model.Application.TeachingTopics</dd></div><div><dt>Submitted</dt><dd>@UserTime.Format(Model.Application.SubmittedUtc, "dd MMM yyyy, HH:mm:ss")<span class="record-secondary">@UserTime.Id</span></dd></div><div><dt>Non-overlapping teaching history</dt><dd>About @((Model.Application.TeachingDays / 365.2425).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) years · @Model.Application.TeachingDays days <span class="record-secondary">Applicant-supplied dates; administrator verification required.</span></dd></div></dl>
@foreach (var role in Model.Experience) { <div class="application-role"><strong>@role.Position · @role.Institution</strong><p>@role.Subjects</p><span class="record-secondary">@role.StartDate?.ToString("dd MMM yyyy") — @(role.EndDate?.ToString("dd MMM yyyy") ?? "Current at submission")</span></div> }
<a class="btn btn-outline-secondary mt-3" asp-controller="Education" asp-action="Evidence" asp-route-id="@Model.Application.Id">Download teaching evidence (PDF)</a>
@if (!string.IsNullOrWhiteSpace(Model.Application.SupportingInformation)) { <h3 class="h6 mt-4">Supporting information</h3><p class="preserve-lines">@Model.Application.SupportingInformation</p> }
@if (!string.IsNullOrWhiteSpace(Model.Application.SubmissionNote)) { <h3 class="h6 mt-4">Response to previous review</h3><p class="preserve-lines">@Model.Application.SubmissionNote</p> }
</section>
<section class="surface-panel mb-4"><h2 class="h5">Review history</h2>
@if (Model.Reviews.Count == 0) { <p class="text-secondary mb-0">Awaiting administrator review. Your account remains Student while this application is pending.</p> }
@foreach (var review in Model.Reviews) { <article class="application-role"><h3 class="h6">Submission @Model.History.First(h => h.Id == review.ApplicationId).Revision · @review.Decision · @review.ReasonCategory</h3><p class="preserve-lines">@review.Reason</p><span class="record-secondary">@review.ReviewerName · @UserTime.Format(review.ReviewedUtc, "dd MMM yyyy, HH:mm:ss") · @UserTime.Id</span>
@if (User.IsInRole(AccountRoles.Admin)) { <p class="mt-2 mb-0 preserve-lines"><strong>Internal verification:</strong> @review.VerificationNotes</p><p class="form-text">Verified years: @review.VerifiedYears · Relevant field: @review.RelevantTeaching · Experience verified: @review.ExperienceVerified · Evidence verified: @review.EvidenceVerified · Details consistent: @review.DetailsConsistent</p> }
</article> }
</section>
<section class="surface-panel"><h2 class="h5">Submission history</h2><ul class="application-history">@foreach (var entry in Model.History) { <li><a asp-controller="@(User.IsInRole(AccountRoles.Admin) ? "Admin" : "Education")" asp-action="@(User.IsInRole(AccountRoles.Admin) ? "ReviewApplication" : "Status")" asp-route-id="@entry.Id">Submission @entry.Revision</a><span>@entry.Status · @UserTime.Format(entry.SubmittedUtc, "dd MMM yyyy, HH:mm")</span></li> }</ul></section>
