@* ADMIN - Reusable submitted application evidence and revision history for applicant and Admin inspection. *@
@model ApplicationDetailsModel
<section class="surface-panel mb-4"><div class="section-heading"><h2>Submission @Model.Application.Revision</h2><partial name="_ApplicationStatus" model="Model.Application.Status" /></div>
<dl class="application-details"><div><dt>Applicant</dt><dd>@Model.Application.FullName<span class="record-secondary">@Model.ApplicantEmail</span></dd></div><div><dt>Professional email</dt><dd>@Model.Application.WorkEmail</dd></div><div><dt>Teaching topics</dt><dd>@Model.Application.TeachingTopics</dd></div><div><dt>Submitted</dt><dd>@UserTime.Format(Model.Application.SubmittedUtc, "dd MMM yyyy, HH:mm:ss")</dd></div><div><dt>Non-overlapping teaching history</dt><dd>About @((Model.Application.TeachingDays / 365.2425).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) years · @Model.Application.TeachingDays days <span class="record-secondary">Applicant-supplied dates; administrator verification required.</span></dd></div></dl>
@foreach (var role in Model.Experience) { <div class="application-role"><strong>@role.Position · @role.Institution</strong><p>@role.Subjects</p><span class="record-secondary">@role.StartDate?.ToString("dd MMM yyyy") — @(role.EndDate?.ToString("dd MMM yyyy") ?? "Current at submission")</span></div> }
<a class="btn btn-outline-secondary mt-3" asp-controller="Education" asp-action="Evidence" asp-route-id="@Model.Application.Id">Download teaching evidence (PDF)</a>
@if (!string.IsNullOrWhiteSpace(Model.Application.SupportingInformation)) { <h3 class="h6 mt-4">Supporting information</h3><p class="preserve-lines">@Model.Application.SupportingInformation</p> }
@if (!string.IsNullOrWhiteSpace(Model.Application.SubmissionNote)) { <h3 class="h6 mt-4">Response to previous review</h3><p class="preserve-lines">@Model.Application.SubmissionNote</p> }
</section>
<section class="surface-panel review-history mb-4"><h2 class="h5">Review history</h2>
@if (Model.Reviews.Count == 0) {
    <p class="text-secondary mb-0">Awaiting administrator review. Your account remains Student while this application is pending.</p>
} else {
    <p class="form-text review-time-zone">Times shown in @UserTime.Id.</p>
}
@foreach (var review in Model.Reviews) {
    <article class="application-role review-entry">
        <div class="review-entry-heading"><h3 class="h6">Submission @Model.History.First(h => h.Id == review.ApplicationId).Revision review</h3><partial name="_ApplicationStatus" model="review.Decision" /></div>
        <dl class="review-decision-details">
            <div><dt>Reason</dt><dd>@review.ReasonCategory</dd></div>
            <div><dt>Explanation</dt><dd class="preserve-lines">@review.Reason</dd></div>
        </dl>
        <p class="review-meta">Reviewed by @review.ReviewerName · <time datetime="@review.ReviewedUtc.ToString("yyyy-MM-ddTHH:mm:ss'Z'")">@UserTime.Format(review.ReviewedUtc, "dd MMM yyyy, HH:mm:ss")</time></p>
        @if (User.IsInRole(AccountRoles.Admin)) {
            <details class="verification-details">
                <summary>Verification details</summary>
                <dl class="verification-checks">
                    <div><dt>Verified teaching experience</dt><dd>@review.VerifiedYears.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) years</dd></div>
                    <div><dt>Relevant teaching subjects</dt><dd>@(review.RelevantTeaching ? "Confirmed" : "Not confirmed")</dd></div>
                    <div><dt>Five years of teaching verified</dt><dd>@(review.ExperienceVerified ? "Confirmed" : "Not confirmed")</dd></div>
                    <div><dt>Teaching evidence verified</dt><dd>@(review.EvidenceVerified ? "Confirmed" : "Not confirmed")</dd></div>
                    <div><dt>Applicant details consistent</dt><dd>@(review.DetailsConsistent ? "Confirmed" : "Not confirmed")</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(review.VerificationNotes)) {
                    <div class="verification-notes"><h4 class="h6">Verification notes</h4><p class="preserve-lines">@review.VerificationNotes</p></div>
                }
            </details>
        }
    </article>
}
</section>
<section class="surface-panel"><h2 class="h5">Submission history</h2>
<table class="submission-history-table"><caption class="visually-hidden">Application submissions, newest first. Times shown in @UserTime.Id.</caption><thead><tr><th scope="col">Submission</th><th scope="col">Submitted on</th><th scope="col">Status</th></tr></thead><tbody>
@foreach (var entry in Model.History.OrderByDescending(h => h.Revision)) {
<tr><td><a asp-controller="@(User.IsInRole(AccountRoles.Admin) ? "Admin" : "Education")" asp-action="@(User.IsInRole(AccountRoles.Admin) ? "ReviewApplication" : "Status")" asp-route-id="@entry.Id" aria-current="@(entry.Id == Model.Application.Id ? "page" : null)">Submission @entry.Revision</a>@if (entry.Revision == Model.History.Max(h => h.Revision)) { <span class="submission-latest">Latest</span> }</td><td>@UserTime.Format(entry.SubmittedUtc, "dd MMM yyyy, HH:mm")</td><td><partial name="_ApplicationStatus" model="entry.Status" /></td></tr>
}
</tbody></table></section>
