@model SupportListModel
@{ var admin = ViewData["SupportAdmin"] as bool? == true; }
<div class="table-responsive surface-table"><table class="table module-table @(admin ? "admin-status-table admin-support-table" : "")"><caption class="visually-hidden">Account support requests. Times shown in @UserTime.Id.</caption><thead><tr><th scope="col">Request</th>@if (admin) { <th scope="col">User</th><th scope="col">Type</th> }<th scope="col">Status</th><th scope="col">Updated</th>@if (admin) { <th scope="col">Action</th> }</tr></thead><tbody>
@foreach (var item in Model.Tickets) { <tr><td>@if (admin) { <span>#@item.Id · @item.Subject</span> } else { <a asp-controller="Support" asp-action="Thread" asp-route-id="@item.Id">#@item.Id · @item.Subject</a> }@if (admin ? item.AdminReadUtc is null : item.UserReadUtc is null) { <span class="record-secondary">Unread update</span> }</td>@if (admin) { <td>@Model.Users.GetValueOrDefault(item.UserId, "Account")<span class="record-secondary">@(Model.DisabledUsers.Contains(item.UserId) ? "Disabled account" : "Active account")</span></td><td>@item.Category</td> }<td><span class="support-status" data-status="@item.Status">@item.Status</span></td><td>@UserTime.Format(item.UpdatedUtc,"dd MMM yyyy, HH:mm")</td>@if (admin) { <td><div class="table-actions"><a asp-controller="Admin" asp-action="SupportThread" asp-route-id="@item.Id" class="text-nowrap" aria-label="View conversation for request #@item.Id">View conversation</a></div></td> }</tr> }
@if (Model.Tickets.Count == 0) { <tr><td colspan="@(admin ? 6 : 3)">No support requests match this view.</td></tr> }
</tbody></table></div>
<partial name="_Pagination" model='new PaginationModel(Model.Page, Model.PageCount, $"{Model.Total} {(Model.Total == 1 ? "request" : "requests")}")' />
