@* ADMIN - Compose the authenticated workspace and one shared verification dialog for sensitive Admin forms. *@
@{ Layout = "_WorkspaceLayout"; }
@RenderBody()
<partial name="_AdminVerifyDialog" />
@section Styles { @await RenderSectionAsync("Styles", required: false) }
@section Scripts { <script src="~/js/admin-operations.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts", required: false) }
