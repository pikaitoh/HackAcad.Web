@{ Layout = "_Layout"; }
<div class="container admin-workspace">
    <aside class="admin-sidebar">
        <div class="workspace-title"><svg width="22" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></svg><span>Administration</span></div>
        <partial name="_AdminNav" />
        <div class="workspace-note"><strong>Account &amp; platform access</strong><p>Manage who can learn, teach and administer HackAcad.</p></div>
        <a class="sidebar-back" asp-controller="Account" asp-action="Profile">My profile <span aria-hidden="true">↗</span></a>
    </aside>
    <div class="admin-main">@RenderBody()</div>
</div>
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
