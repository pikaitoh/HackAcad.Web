<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HackAcad</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-0">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">HackAcad</a>
                <div class="navbar-nav ms-auto align-items-sm-center gap-sm-2">
                    <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link text-light" href="/Identity/Account/Login">Log in</a>
                    <a class="btn btn-sm btn-outline-light" href="/Identity/Account/Register">Sign up</a>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted text-center py-3 mt-5">
        &copy; 2026 HackAcad — CT050-3-2-WAPP Group Assignment
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
