<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HackAcad</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-0">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">HackAcad</a>
                <div class="navbar-nav ms-auto align-items-sm-center gap-sm-2 site-account-nav">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
        @if (TempData["Success"] is string message)
        {
            <div class="container pt-3"><div class="alert alert-success mb-0" role="status">@message</div></div>
        }
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted text-center py-3 mt-5">
        &copy; 2026 HackAcad — CT050-3-2-WAPP Group Assignment
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/account-forms.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
