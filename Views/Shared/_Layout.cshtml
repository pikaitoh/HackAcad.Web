@{ var signedIn = User.Identity?.IsAuthenticated == true; var isAdmin = User.IsInRole(AccountRoles.Admin); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="@(ViewData["ThemeColor"] ?? "#193e46")" />
    <title>@ViewData["Title"] - HackAcad</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="preload" href="~/fonts/Figtree-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/education.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["PageClass"]">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand" data-bs-theme="dark" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="@(signedIn ? (isAdmin ? "Admin" : "Account") : "Home")" asp-action="@(signedIn && !isAdmin ? "Dashboard" : "Index")" aria-label="@(signedIn ? "HackAcad dashboard" : "HackAcad home")"><partial name="_Brand" /></a>
                @if (signedIn)
                {
                    <div class="navbar-nav site-account-nav signed-in-nav" id="site-navigation"><partial name="_LoginPartial" /></div>
                }
                else
                {
                    <div class="d-flex flex-grow-1 justify-content-end" id="site-navigation"><div class="navbar-nav align-items-center site-account-nav"><partial name="_LoginPartial" /></div></div>
                }
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
        @if (TempData["Success"] is string message)
        {
            <div class="container pt-3"><div class="alert alert-success mb-0" role="status">@message</div></div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container footer-inner"><span>&copy; 2026 HackAcad</span><span>Learn. Practise. Prove it.</span></div></footer>
    <script src="~/js/account-forms.js" asp-append-version="true" defer></script>
    <script src="~/js/account-menu.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
