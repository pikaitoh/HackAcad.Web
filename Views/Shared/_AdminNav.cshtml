@inject HackAcad.Web.Data.ApplicationDbContext NavigationDb
@using Microsoft.EntityFrameworkCore
@{ var action = ViewContext.RouteData.Values["action"]?.ToString() ?? ""; }
@{ var adminId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
var auditor = await NavigationDb.Admins.AnyAsync(a => a.UserId == adminId && a.IsReadOnly);
var alerts = await NavigationDb.SecurityAlerts.CountAsync(a => a.Status != "Resolved");
var waiting = auditor ? 0 : await NavigationDb.SupportTickets.CountAsync(t => t.Status == "Awaiting admin"); }
<nav class="admin-nav" aria-label="Administration">
    @if (!auditor) {
    <a asp-controller="Admin" asp-action="Index" aria-current="@(action == "Index" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Dashboard</a>
    <a asp-controller="Admin" asp-action="Users" aria-current="@(action.Contains("User") || action == "AccountStatus" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m1-16a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v3"/></svg>Users</a>
    <a asp-controller="Admin" asp-action="Applications" aria-current="@(action is "Applications" or "ReviewApplication" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h12v18H4zm4 5h4m-4 4h4m5 1 3 3 4-5"/></svg>Instructor applications</a>
    <a asp-controller="Admin" asp-action="Courses" aria-current="@(action.Contains("Course") ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Zm0 0v15"/></svg>Courses</a>
    <a asp-controller="Admin" asp-action="SupportRequests" aria-current="@(action is "SupportRequests" or "SupportThread" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v13H8l-5 4Z"/><path d="M7 8h10M7 12h7"/></svg>Account support @if (waiting > 0) { <span class="nav-count">@waiting</span> }</a>
    }
    <a asp-controller="Admin" asp-action="Security" aria-current="@(action is "Security" or "Alert" or "Verify" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4v5c0 5-8 9-8 9s-8-4-8-9V7Z"/><path d="M12 8v5m0 3h.01"/></svg>Security @if (alerts > 0) { <span class="nav-count">@alerts</span> }</a>
    <a asp-controller="Admin" asp-action="LoginLogs" aria-current="@(action == "LoginLogs" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6M3 3v6h6m3-2v6l4 2"/></svg>Login logs</a>
    <a asp-controller="Admin" asp-action="AuditLog" aria-current="@(action is "AuditLog" or "Activity" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5v17h14V4h-4M9 3h6v4H9zm-1 9h8m-8 4h8"/></svg>Audit logs</a>
</nav>
