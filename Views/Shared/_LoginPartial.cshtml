<a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole(AccountRoles.Admin)) { <a class="nav-link text-light" asp-controller="Admin" asp-action="Index">Admin</a> }
    <a class="nav-link text-light" asp-controller="Account" asp-action="Dashboard">My account</a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-sm btn-outline-light" type="submit">Log out</button></form>
}
else
{
    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Register">Sign up</a>
}
