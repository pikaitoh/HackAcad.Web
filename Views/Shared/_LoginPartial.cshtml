@{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); }
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole(AccountRoles.Admin))
    {
        <a class="nav-link" asp-controller="Admin" asp-action="Index" aria-current="@(currentController == "Admin" && currentAction == "Index" ? "page" : null)">Dashboard</a>
    }
    else
    {
        <a class="nav-link" asp-controller="Account" asp-action="Dashboard" aria-current="@(currentController == "Account" && currentAction == "Dashboard" ? "page" : null)">Dashboard</a>
    }
    <a class="nav-link" asp-controller="Account" asp-action="Profile" aria-current="@(currentController == "Account" && (currentAction == "Profile" || currentAction == "ChangePassword") ? "page" : null)">My profile</a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-sm btn-outline-secondary" type="submit">Log out</button></form>
}
else
{
    <a class="nav-link" asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)">Home</a>
    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="learning-experience">How it works</a>
    <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
}
