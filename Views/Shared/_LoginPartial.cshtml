@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{ var headerUser = ViewData["HeaderUser"] as System.Security.Claims.ClaimsPrincipal ?? User; var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); }
@if (headerUser.Identity?.IsAuthenticated == true)
{
    var account = await UserManager.GetUserAsync(headerUser);
    var name = account?.DisplayName ?? "Account";
    var initial = string.IsNullOrWhiteSpace(name) ? "H" : System.Globalization.StringInfo.GetNextTextElement(name).ToUpperInvariant();
    <details class="account-menu" data-account-menu>
        <summary class="account-menu-toggle" aria-label="Open account menu">
            @if (account?.AvatarImage is not null) { <img class="account-avatar" src="@Url.Action("Avatar", "Account")" width="40" height="40" alt="" /> }
            else { <span class="account-avatar avatar-initial" aria-hidden="true">@initial</span> }
            <span class="header-username">@name</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </summary>
        <nav class="account-menu-panel" aria-label="Your account">
            <div class="account-menu-heading"><strong>@name</strong><span class="record-secondary">@(headerUser.IsInRole(AccountRoles.Admin) ? "Admin" : headerUser.IsInRole(AccountRoles.Instructor) ? "Instructor" : "Student") account</span></div>
            <a asp-controller="Account" asp-action="Profile" aria-current="@(currentController == "Account" && (ViewData["AccountArea"] as string) == "profile" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg>View profile</a>
            @if (headerUser.IsInRole(AccountRoles.Student) || headerUser.IsInRole(AccountRoles.Instructor)) { <a asp-controller="Courses" asp-action="Saved" aria-current="@(currentController == "Courses" && currentAction == "Saved" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" /></svg>Saved courses</a> }
            @if (headerUser.IsInRole(AccountRoles.Student) || headerUser.IsInRole(AccountRoles.Instructor)) { <a asp-controller="Account" asp-action="Badges" aria-current="@(currentController == "Account" && currentAction == "Badges" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v5a4 4 0 0 1-8 0V3Zm0 2H4v2a4 4 0 0 0 4 4m8-6h4v2a4 4 0 0 1-4 4M12 12v5m-4 4h8l-1-4H9l-1 4Z" /></svg>Badges</a> }
            <a asp-controller="Account" asp-action="Settings" aria-current="@(currentController == "Account" && (ViewData["AccountArea"] as string) == "manage" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4v5c0 5-8 9-8 9s-8-4-8-9V7Z" /><path d="m8 12 3 3 5-6" /></svg>Manage account</a>
            @if (headerUser.IsInRole(AccountRoles.Student) && !headerUser.IsInRole(AccountRoles.Admin) && !headerUser.IsInRole(AccountRoles.Instructor)) { <a asp-controller="Education" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 8 10-5 10 5-10 5Zm4 3v6c4 3 8 3 12 0v-6m4-3v10"/></svg>For Education</a> }
            @if (!headerUser.IsInRole(AccountRoles.Admin)) { <a asp-controller="Support" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v13H8l-5 4Z"/><path d="M7 8h10M7 12h7"/></svg>Contact support</a> }
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4v16h6m4-13 5 5-5 5M9 12h10" /></svg>Log out</button></form>
        </nav>
    </details>
}
else
{
    <a class="nav-link" asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)">Home</a>
    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="learning-experience">How it works</a>
    <a class="nav-link" asp-controller="Education" asp-action="Index" aria-current="@(currentController == "Education" ? "page" : null)">For Education</a>
    <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
}
