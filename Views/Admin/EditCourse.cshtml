@model EditCourseModel
@{ ViewData["Title"] = "Review course"; }
<div class="admin-content"><div class="page-heading"><div><h1>Review course</h1><p class="text-secondary">Owned by @Model.Instructor. Update its catalogue details and publication status.</p></div></div>
    <form asp-action="EditCourse" asp-route-id="@Model.CourseId" method="post" data-validated-form class="form-measure">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" data-trim aria-invalid="@(ViewData.ModelState["Title"]?.Errors.Count > 0 ? "true" : null)" class="form-control" maxlength="150" required aria-describedby="Title-help Title-error" /><p id="Title-help" class="form-text">Required. Up to 150 characters.</p><span id="Title-error" asp-validation-for="Title" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" data-trim aria-invalid="@(ViewData.ModelState["Category"]?.Errors.Count > 0 ? "true" : null)" class="form-control" maxlength="50" aria-describedby="Category-help Category-error" /><p id="Category-help" class="form-text">Optional. Up to 50 characters.</p><span id="Category-error" asp-validation-for="Category" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" data-trim aria-invalid="@(ViewData.ModelState["Description"]?.Errors.Count > 0 ? "true" : null)" class="form-control" rows="5" maxlength="1000" aria-describedby="Description-help Description-error"></textarea><p id="Description-help" class="form-text">Optional. Up to 1,000 characters.</p><span id="Description-error" asp-validation-for="Description" class="field-error" aria-live="polite"></span></div>
        <div class="form-check mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Save course</button><a asp-action="Courses" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
