@model EditCourseModel
@{ ViewData["Title"] = "Review course"; }
<div class="container module-shell"><partial name="_AdminNav" /><div class="page-heading"><div><h1>Review course</h1><p class="text-secondary">Owned by @Model.Teacher. Update its catalogue details and publication status.</p></div></div>
    <form asp-action="EditCourse" asp-route-id="@Model.CourseId" method="post" class="form-measure">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" aria-invalid="@(ViewData.ModelState["Title"]?.Errors.Count > 0 ? "true" : null)" class="form-control" maxlength="150" required  aria-describedby="Title-error" /><span id="Title-error" asp-validation-for="Title" class="field-error"></span></div>
        <div class="mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" aria-invalid="@(ViewData.ModelState["Category"]?.Errors.Count > 0 ? "true" : null)" class="form-control" maxlength="50"  aria-describedby="Category-error" /><span id="Category-error" asp-validation-for="Category" class="field-error"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" aria-invalid="@(ViewData.ModelState["Description"]?.Errors.Count > 0 ? "true" : null)" class="form-control" rows="5" maxlength="1000" aria-describedby="Description-error"></textarea><span id="Description-error" asp-validation-for="Description" class="field-error"></span></div>
        <div class="form-check mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div>
        <div class="form-actions"><button class="btn btn-dark" type="submit">Save course</button><a asp-action="Courses" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
