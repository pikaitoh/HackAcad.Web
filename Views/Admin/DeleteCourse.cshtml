@* ADMIN - Deletion confirmation: courses referenced by student learning records cannot be permanently deleted. *@
@model Course
@{ var blocked = ViewData["HasLearningData"] as bool? == true; ViewData["Title"] = blocked ? "Course cannot be deleted" : "Delete course"; }
<div class="admin-content admin-confirm-page"><div class="form-measure"><h1>@ViewData["Title"]</h1>
@if (blocked) {
<p><strong>@Model.Title</strong> has enrolments or learning records and cannot be permanently deleted.</p>
<p>@(Model.IsPublished ? "Unpublish the course to remove it from the catalogue while preserving students' records." : "This course is already unpublished. Its learning records will be preserved.")</p>
<div class="form-actions"><a class="btn btn-primary" asp-action="EditCourse" asp-route-id="@Model.CourseId">Review publication settings</a><a asp-action="Courses" class="btn btn-outline-secondary">Back to courses</a></div>
} else {
<p><strong>@Model.Title</strong> has no enrolments or learning records. Deleting it will permanently remove its lessons, challenges and simulation tasks.</p>
<p>This action cannot be undone.</p>
<form data-admin-operation asp-action="DeleteCourse" asp-route-id="@Model.CourseId" method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-actions"><button type="submit" class="btn btn-danger">Delete course permanently</button><a asp-action="Courses" class="btn btn-outline-secondary">Cancel</a></div></form>
}</div></div>
