@model Course
@{ ViewData["Title"] = "Delete course"; }
<div class="admin-content"><div class="form-measure"><h1>Delete course</h1><p>Delete <strong>@Model.Title</strong> and its lessons, challenges and simulation tasks?</p><p>Courses with enrolments or learning records cannot be deleted. You can <a asp-action="EditCourse" asp-route-id="@Model.CourseId">unpublish the course</a> to preserve students' work.</p><form asp-action="DeleteCourse" asp-route-id="@Model.CourseId" method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-actions"><button type="submit" class="btn btn-danger">Delete course permanently</button><a asp-action="Courses" class="btn btn-outline-secondary">Cancel</a></div></form></div></div>
