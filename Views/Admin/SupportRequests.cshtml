@model SupportListModel
@{ ViewData["Title"] = "Account support"; ViewData["SupportAdmin"] = true; }
<div class="admin-content"><div class="page-heading"><div><h1>Account support</h1><p class="text-secondary">Review account access questions and keep each reply with its conversation.</p></div></div>
<form method="get" class="filter-bar support-filters"><div class="filter-search"><label asp-for="Search" class="form-label">Search requests</label><input asp-for="Search" class="form-control" placeholder="Subject, username or email" /></div><div><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="">All statuses</option><option>Awaiting admin</option><option>Awaiting user</option><option>Resolved</option></select></div><div><label asp-for="Category" class="form-label">Request type</label><select asp-for="Category" class="form-select"><option value="">All types</option>@foreach (var category in SupportCategory.All.Append("Account support")) { <option>@category</option> }</select></div><button class="btn btn-primary">Apply filters</button><a asp-action="SupportRequests" class="btn btn-outline-secondary">Clear</a></form>
<partial name="_SupportList" model="Model" /></div>
