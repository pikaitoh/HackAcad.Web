@* ADMIN - Investigation form: retain the record version and safe return URL while changing status or notes. *@
@model SecurityAlert
@{ ViewData["Title"] = "Security alert"; }
<div class="admin-content security-measure"><div class="page-heading"><div><h1>Security alert</h1><p class="text-secondary">Times shown in @UserTime.Id.</p></div><a href='@(ViewData["ReturnUrl"])' class="btn btn-outline-secondary">Back to security</a></div>
<section class="surface-panel"><div class="page-heading"><h2 class="h4">@Model.Title</h2><span class="support-status" data-status="@Model.Status">@Model.Status</span></div><p>@Model.Explanation</p><dl class="application-details"><div><dt>IP address</dt><dd>@Model.IpAddress</dd></div><div><dt>Created</dt><dd>@UserTime.Format(Model.CreatedUtc,"dd MMM yyyy, HH:mm:ss")</dd></div></dl>
@if (Model.UserId is not null && ViewData["ReadOnlyAdmin"] as bool? != true) { <a asp-action="UserDetails" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Review account</a> }
@if (ViewData["ReadOnlyAdmin"] as bool? == true) { <h3 class="h5 mt-4">Investigation notes</h3><p class="support-message-body">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p> }
else { <form data-admin-operation method="post" class="mt-4"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Version" type="hidden" /><input name="ReturnUrl" type="hidden" value='@(ViewData["ReturnUrl"])' /><label asp-for="Status" class="form-label">Investigation status</label><select asp-for="Status" class="form-select mb-3"><option>New</option><option>Investigating</option><option>Resolved</option></select><label asp-for="Notes" class="form-label">Investigation notes</label><textarea asp-for="Notes" class="form-control" rows="5" required minlength="10" maxlength="1000" aria-describedby="notes-help"></textarea><p id="notes-help" class="form-text">Explain the finding, including false positives, before resolving an alert.</p><button class="btn btn-primary">Save investigation</button></form> }
</section></div>
