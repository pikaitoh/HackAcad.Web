@* ADMIN - Resolved investigations are read-only; open forms retain the record version and safe return URL. *@
@model SecurityAlert
@{ ViewData["Title"] = "Security alert"; }
<div class="admin-content security-measure"><div class="page-heading"><div><h1>Security alert</h1><p class="text-secondary">Times shown in @UserTime.Id.</p></div><a href='@(ViewData["ReturnUrl"])' class="btn btn-outline-secondary">Back to security</a></div>
<section class="surface-panel"><div class="page-heading"><h2 class="h4">@Model.Title</h2><span class="support-status" data-status="@Model.Status">@Model.Status</span></div><p>@Model.Explanation</p><dl class="application-details"><div><dt>IP address</dt><dd>@Model.IpAddress</dd></div><div><dt>Created</dt><dd>@UserTime.Format(Model.CreatedUtc,"dd MMM yyyy, HH:mm:ss")</dd></div></dl>
@if (Model.UserId is not null && ViewData["ReadOnlyAdmin"] as bool? != true) { <a asp-action="UserDetails" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Review account</a> }
</section>
@if (ViewData["AccountContext"] is AdminAccountContextModel account) {
<section class="surface-panel mt-4 mb-4"><div class="context-section-heading"><h2 class="h5">@account.DisplayName</h2>@if (ViewData["ReadOnlyAdmin"] as bool? != true) { <a asp-action="Sessions" asp-route-id="@account.UserId">Review sessions</a> }</div><p class="text-secondary">@account.Email</p><partial name="_AdminAccountContext" model="account" /></section>
}
@if (ViewData["AlertEvidence"] is AdminSignInActivityModel evidence) { <div class="mt-4"><partial name="_AdminSignInActivity" model="evidence" /></div> }
<section class="surface-panel mt-4"><h2 class="h5">Investigation</h2>
@if (Model.Status == "Resolved") { <p class="support-waiting mt-4" role="status">This security alert has been resolved. The investigation is read-only.</p> }
@if (Model.Status == "Resolved" || ViewData["ReadOnlyAdmin"] as bool? == true) { <h3 class="h5 mt-4">Investigation notes</h3><p class="support-message-body">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p> }
else { <form data-admin-operation data-validated-form novalidate method="post" class="mt-4"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Version" type="hidden" /><input name="ReturnUrl" type="hidden" value='@(ViewData["ReturnUrl"])' /><label asp-for="Status" class="form-label">Investigation status</label><select asp-for="Status" class="form-select mb-3"><option>New</option><option>Investigating</option><option>Resolved</option></select><label asp-for="Notes" class="form-label">Investigation notes</label><textarea asp-for="Notes" class="form-control" rows="5" required minlength="10" maxlength="1000" data-trim data-val-required="Please enter investigation notes." data-val-length="Please enter between 10 and 1,000 characters." aria-describedby="notes-help Notes-error"></textarea><span asp-validation-for="Notes" id="Notes-error" class="field-error" aria-live="polite"></span><p id="notes-help" class="form-text">Explain the finding, including false positives, before resolving an alert.</p><button class="btn btn-primary">Save investigation</button></form> }
</section></div>
