@model AdminSessionsModel
@{ ViewData["Title"] = "Account sessions"; }
<div class="admin-content"><div class="page-heading"><div><h1>Account sessions</h1><p class="text-secondary">@Model.DisplayName · Active means usable, not necessarily online. Times shown in @UserTime.Id.</p></div><a asp-action="UserDetails" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Back to user</a></div>
<section class="surface-panel"><h2 class="h5">Active browser sessions</h2><ul class="security-actions">@foreach (var item in Model.Sessions) { <li><strong>@item.Device</strong> · @item.IpAddress<span class="record-secondary">Created @UserTime.Format(item.CreatedUtc,"dd MMM yyyy, HH:mm") · Last activity @UserTime.Format(item.LastSeenUtc,"dd MMM yyyy, HH:mm")</span></li> }@if (Model.Sessions.Count == 0) { <li>No active sessions.</li> }</ul>
@if (Model.Sessions.Count > 0) { <form data-admin-operation asp-action="RevokeSessions" asp-route-id="@Model.UserId" method="post"><label for="sessionId" class="form-label">Sessions to revoke</label><select id="sessionId" name="sessionId" class="form-select mb-3"><option value="">All active sessions</option>@foreach (var item in Model.Sessions) { <option value="@item.Id">@item.Device · @item.IpAddress · @UserTime.Format(item.LastSeenUtc,"dd MMM, HH:mm")</option> }</select><label for="reason" class="form-label">Reason</label><textarea id="reason" name="reason" class="form-control mb-3" rows="3" required minlength="10" maxlength="500"></textarea><p class="form-text">The user must sign in again. Revoking your own session also signs you out. This action is recorded in the audit log.</p><button class="btn btn-danger">Revoke selected sessions</button></form> }
</section></div>
