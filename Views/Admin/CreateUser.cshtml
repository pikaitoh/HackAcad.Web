@model CreateUserModel
@{ ViewData["Title"] = "Create account"; }
<div class="admin-content">
    <div class="page-heading"><div><h1>Create account</h1><p class="text-secondary">Create a user and assign their initial access.</p></div></div>
    <form asp-action="CreateUser" method="post" data-account-form class="form-measure">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" data-trim aria-invalid="@(ViewData.ModelState["DisplayName"]?.Errors.Count > 0 ? "true" : null)" class="form-control" minlength="2" maxlength="50" autocomplete="off" required  aria-describedby="DisplayName-help DisplayName-error" /><p id="DisplayName-help" class="form-text">2–50 characters. Use letters, numbers, spaces, . _ - or apostrophes.</p><span id="DisplayName-error" asp-validation-for="DisplayName" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" data-trim aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" class="form-control" type="email" maxlength="256" autocomplete="off" required  aria-describedby="Email-error" /><span id="Email-error" asp-validation-for="Email" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" aria-invalid="@(ViewData.ModelState["Role"]?.Errors.Count > 0 ? "true" : null)" class="form-select" aria-describedby="Role-error">@foreach (var role in AccountRoles.All) { <option value="@role">@role</option> }</select><span id="Role-error" asp-validation-for="Role" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Initial password</label><input asp-for="Password" aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" aria-describedby="password-help Password-error" required /><p id="password-help" class="form-text">Use 8–100 characters with uppercase, lowercase, a number and a symbol. The user can change it in their profile.</p><span id="Password-error" asp-validation-for="Password" class="field-error" aria-live="polite"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" aria-invalid="@(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="new-password" required  aria-describedby="ConfirmPassword-error" /><span id="ConfirmPassword-error" asp-validation-for="ConfirmPassword" class="field-error" aria-live="polite"></span></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Create account</button><a asp-action="Users" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
