@model InstructorApplicationListModel
@{ ViewData["Title"] = "Instructor applications"; }
<div class="admin-content"><div class="page-heading"><div><h1>Instructor applications</h1><p class="text-secondary">Review the latest submission from each applicant using the same five-year teaching and evidence requirements.</p></div></div>
<form method="get" class="filter-bar"><div class="filter-search"><label for="search" class="form-label">Search applicants</label><input name="search" id="search" value="@Model.Search" class="form-control" maxlength="150" placeholder="Name or professional email" /></div><div><label for="status" class="form-label">Application status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in new[] { ApplicationStatus.Pending, ApplicationStatus.MoreInformation, ApplicationStatus.Approved, ApplicationStatus.Rejected }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }</select></div><button class="btn btn-primary" type="submit">Apply filters</button><a asp-action="Applications" class="btn btn-outline-secondary">Clear</a></form>
<p class="text-secondary small list-results">@ListPresentation.Summary(Model.Total, "application", !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.Status))</p>
@if (Model.Applications.Count == 0) { <div class="empty-state"><h2 class="h5">No matching applications</h2><p>Submitted Instructor applications appear here. Try clearing your filters.</p></div> }
else { <div class="table-responsive"><table class="table module-table"><caption class="visually-hidden">Latest Instructor applications</caption><thead><tr><th>Applicant</th><th>Teaching topics</th><th>Submission</th><th>Status</th><th>Submitted</th><th>Action</th></tr></thead><tbody>@foreach (var application in Model.Applications) { <tr><td><strong>@application.FullName</strong><span class="record-secondary">@application.WorkEmail</span></td><td>@application.TeachingTopics</td><td>@application.Revision</td><td><partial name="_ApplicationStatus" model="application.Status" /></td><td>@UserTime.Format(application.SubmittedUtc, "dd MMM yyyy, HH:mm")</td><td><a asp-action="ReviewApplication" asp-route-id="@application.Id">Review application</a></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model='new PaginationModel(Model.Page, Model.PageCount, ListPresentation.Count(Model.Total, "application"))' /></div>
