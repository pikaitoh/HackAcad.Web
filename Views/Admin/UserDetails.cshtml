@model UserRow
@{ ViewData["Title"] = "User details"; var statusInput = ViewData["StatusInput"] as AccountStatusInput; }
<div class="admin-content"><div class="page-heading"><div><h1>User details</h1><p class="text-secondary">Personal details are read-only. The account owner manages their profile, email and password.</p></div><a asp-action="Users">Back to users</a></div>
<div class="education-columns"><section class="surface-panel"><h2 class="h5">@Model.DisplayName</h2><dl class="application-details"><div><dt>Full name</dt><dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Not provided" : Model.FullName)</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Role</dt><dd>@Model.Role</dd></div><div><dt>Account access</dt><dd>@(Model.IsDisabled ? "Disabled" : "Active")</dd></div><div><dt>Email verification</dt><dd>@(Model.EmailConfirmed ? "Verified" : "Unverified")</dd></div><div><dt>Joined</dt><dd>@UserTime.Format(Model.JoinedDate, "dd MMM yyyy, HH:mm:ss")</dd></div><div><dt>Last login</dt><dd>@(Model.LastLoginUtc is { } login ? UserTime.Format(login, "dd MMM yyyy, HH:mm:ss") : "No record")</dd></div><div><dt>Last password changed</dt><dd>@(Model.LastPasswordChangedUtc is { } changed ? UserTime.Format(changed, "dd MMM yyyy, HH:mm:ss") : "No record")</dd></div></dl><p class="form-text">Times shown in @UserTime.Id.</p></section>
<section class="surface-panel"><h2 class="h5">Account access</h2><p class="text-secondary">Disabling blocks login and revokes existing sessions. It preserves courses, progress and account records. Instructor roles are granted only through application review.</p>
@if (Model.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) { <form asp-action="AccountStatus" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><input type="hidden" name="Disable" value="@((!Model.IsDisabled).ToString().ToLowerInvariant())" /><label for="Reason" class="form-label">Reason for @(Model.IsDisabled ? "reactivating" : "disabling") this account</label><textarea id="Reason" name="Reason" class="form-control mb-3" rows="4" required minlength="10" maxlength="500">@statusInput?.Reason</textarea><p class="form-text">This reason and your identity will be recorded in the audit log.</p><button type="submit" class="btn @(Model.IsDisabled ? "btn-primary" : "btn-danger")">@(Model.IsDisabled ? "Reactivate account" : "Disable account")</button></form> }
else { <p class="form-text">You cannot change your own account access.</p> }
</section></div></div>
