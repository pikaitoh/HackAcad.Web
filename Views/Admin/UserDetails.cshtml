@model UserRow
@{ ViewData["Title"] = "User details"; var statusInput = ViewData["StatusInput"] as AccountStatusInput; var isSelf = Model.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="admin-content @(isSelf ? "user-details-self" : "")"><div class="page-heading"><div><h1>User details</h1><p class="text-secondary">Personal details are read-only. The account owner manages their profile, email and password.</p></div><a asp-action="Users" class="btn btn-outline-secondary back-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg>Back to users</a></div>
<div class="education-columns user-details-columns"><section class="surface-panel"><h2 class="h5">@Model.DisplayName</h2><dl class="application-details"><div><dt>Full name</dt><dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Not provided" : Model.FullName)</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Role</dt><dd>@Model.Role</dd></div><div><dt>Account access</dt><dd>@(Model.IsDisabled ? "Disabled" : "Active")@if (isSelf) { <span class="record-secondary">You cannot change your own account access.</span> }</dd></div><div><dt>Email verification</dt><dd>@(Model.EmailConfirmed ? "Verified" : "Unverified")</dd></div><div><dt>Joined</dt><dd>@UserTime.Format(Model.JoinedDate, "dd MMM yyyy, HH:mm:ss")</dd></div><div><dt>Last login</dt><dd>@(Model.LastLoginUtc is { } login ? UserTime.Format(login, "dd MMM yyyy, HH:mm:ss") : "No record")</dd></div><div><dt>Last password changed</dt><dd>@(Model.LastPasswordChangedUtc is { } changed ? UserTime.Format(changed, "dd MMM yyyy, HH:mm:ss") : "No record")</dd></div></dl><p class="form-text">Times shown in @UserTime.Id.</p></section>
@if (!isSelf) {
<section class="surface-panel"><h2 class="h5">Account access</h2><p class="text-secondary">@(Model.IsDisabled ? "Reactivating this account allows the user to log in again." : "Disabling this account prevents login and signs out all active sessions. Existing courses, progress and records will be preserved.")</p>
<form asp-action="AccountStatus" asp-route-id="@Model.Id" method="post" data-validated-form novalidate><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><input type="hidden" name="Disable" value="@((!Model.IsDisabled).ToString().ToLowerInvariant())" /><label for="Reason" class="form-label">Reason for @(Model.IsDisabled ? "reactivating" : "disabling") this account <span class="required-mark" aria-hidden="true">*</span></label><textarea id="Reason" name="Reason" class="form-control mb-3" rows="4" required minlength="10" maxlength="500" data-val="true" data-val-required="Please enter a reason for this account access change." data-val-length="Please enter between 10 and 500 characters." data-val-length-min="10" data-val-length-max="500" data-trim aria-describedby="Reason-error">@statusInput?.Reason</textarea><span id="Reason-error" class="field-error" data-valmsg-for="Reason" aria-live="polite">@ViewData.ModelState["Reason"]?.Errors.FirstOrDefault()?.ErrorMessage</span><p class="form-text">This reason and your identity will be recorded in the audit log.</p><button type="submit" class="btn @(Model.IsDisabled ? "btn-primary" : "btn-danger")">@(Model.IsDisabled ? "Reactivate account" : "Disable account")</button></form>
</section>
}</div></div>
