@model SecurityOverviewModel
@{ ViewData["Title"] = "Security overview"; }
<div class="admin-content"><div class="page-heading"><div><h1>Security overview</h1><p class="text-secondary">Review sign-in signals and investigate changes. Times shown in @UserTime.Id.</p></div></div>
@if (ViewData["ReadOnlyAdmin"] as bool? == true) { <p class="alert alert-info">Read-only auditor access. You can inspect security alerts and logs.</p> }
<dl class="security-stats"><div><dt>Failed sign-ins · last 24 hours</dt><dd>@Model.FailedLogins</dd></div><div><dt>Currently locked accounts</dt><dd>@Model.LockedAccounts</dd></div><div><dt>Open security alerts</dt><dd>@Model.OpenAlerts</dd></div></dl>
<h2 class="h4">Security alerts</h2><p class="text-secondary">Rule-based signals need review; they do not prove an attack or automatically disable an account.</p>
<form method="get" class="filter-bar"><div><label asp-for="Status" class="form-label">Investigation status</label><select asp-for="Status" class="form-select"><option value="">All statuses</option><option>New</option><option>Investigating</option><option>Resolved</option></select></div><button class="btn btn-primary">Apply filters</button><a asp-action="Security" class="btn btn-outline-secondary">Clear</a></form>
<div class="table-responsive surface-table"><table class="table module-table"><caption class="visually-hidden">Security alerts</caption><thead><tr><th scope="col">Alert</th><th scope="col">Status</th><th scope="col">IP address</th><th scope="col">Created</th></tr></thead><tbody>
@foreach (var alert in Model.Alerts) { <tr><td><a asp-action="Alert" asp-route-id="@alert.Id">@alert.Title</a></td><td><span class="support-status" data-status="@alert.Status">@alert.Status</span></td><td>@alert.IpAddress</td><td>@UserTime.Format(alert.CreatedUtc,"dd MMM yyyy, HH:mm")</td></tr> }
@if (Model.Alerts.Count == 0) { <tr><td colspan="4">No security alerts match this view.</td></tr> }
</tbody></table></div><partial name="_Pagination" model='new PaginationModel(Model.Page, Model.PageCount, $"{Model.Total} alerts")' />
<section class="surface-panel mt-4"><div class="page-heading"><h2 class="h4">Recent administrative actions</h2><a asp-action="AuditLog" asp-route-kind="admin" class="btn btn-outline-secondary btn-sm">View audit log</a></div><ul class="security-actions">@foreach (var item in Model.RecentActions) { <li><strong>@item.Action</strong> · @item.TargetName<span class="record-secondary">@UserTime.Format(item.OccurredUtc,"dd MMM yyyy, HH:mm:ss") · @item.IpAddress</span></li> }@if (Model.RecentActions.Count == 0) { <li>No administrative actions recorded yet.</li> }</ul></section></div>
