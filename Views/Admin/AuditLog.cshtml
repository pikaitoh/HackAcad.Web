@model AuditLogModel
@{ ViewData["Title"] = "Audit log"; }
<div class="admin-content"><div class="page-heading"><div><h1>Audit log</h1><p class="text-secondary">Management actions and user account security changes. Times shown in @UserTime.Id.</p></div></div>
<form method="get" class="filter-bar"><div class="filter-search"><label for="search" class="form-label">Search actions, targets or reasons</label><input id="search" name="search" value="@Model.Search" maxlength="200" class="form-control" /></div><div><label for="kind" class="form-label">Event category</label><select id="kind" name="kind" class="form-select"><option value="">All events</option><option value="admin" selected="@(Model.Kind == "admin")">Management actions</option><option value="account" selected="@(Model.Kind == "account")">Account security</option></select></div><div class="form-check mb-2"><input id="mine" name="mine" type="checkbox" value="true" checked="@Model.Mine" class="form-check-input" /><label for="mine" class="form-check-label">Only my actions</label></div><button type="submit" class="btn btn-primary">Apply filters</button><a asp-action="AuditLog" class="btn btn-outline-secondary">Clear</a></form>
@if (Model.Records.Count == 0) { <div class="empty-state"><h2 class="h5">No matching actions</h2><p>Recorded management actions appear here. Try clearing your filters.</p></div> } else { <div class="table-responsive"><table class="table module-table"><caption class="visually-hidden">Read-only activity audit history</caption><thead><tr><th>Time</th><th>Performed by</th><th>Action</th><th>Target</th><th>Reason / details</th></tr></thead><tbody>@foreach (var record in Model.Records) { <tr><td>@UserTime.Format(record.OccurredUtc, "dd MMM yyyy, HH:mm:ss")</td><td>@(record.ActorUserId is { } actor && Model.Actors.TryGetValue(actor, out var name) ? name : "Former user")<span class="record-secondary">@record.ActorUserId</span></td><td>@record.Action</td><td>@record.TargetName<span class="record-secondary">@record.TargetType · @record.TargetId</span></td><td class="preserve-lines">@record.Details@if (record.Before is not null || record.After is not null) { <details class="audit-change"><summary>View change</summary><dl><dt>Before</dt><dd>@record.Before</dd><dt>After</dt><dd>@record.After</dd></dl></details> }<span class="record-secondary">@record.Result · @record.IpAddress · @record.Device</span><span class="record-secondary">Event #@record.Id · Request @record.CorrelationId</span></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model='new PaginationModel(Model.Page, Model.PageCount)' /></div>
