@* ADMIN - Read-only history: summaries stay compact, while expandable rows expose evidence and technical metadata. *@
@model AuditLogModel
@{ ViewData["Title"] = "Audit logs"; }
<div class="admin-content">
    <div class="page-heading"><div><h1>Audit logs</h1><p class="text-secondary">Review management actions or account security changes. Times shown in @UserTime.Id.</p></div></div>
    <form method="get" class="filter-bar audit-filters">
        <div class="filter-search"><label for="search" class="form-label">Search actions, targets or reasons</label><input id="search" name="search" value="@Model.Search" maxlength="200" class="form-control" /></div>
        <div><label for="kind" class="form-label">Event category</label><select id="kind" name="kind" class="form-select"><option value="all" selected="@(Model.Kind == "all")">All events</option><option value="admin" selected="@(Model.Kind == "admin")">Management actions</option><option value="account" selected="@(Model.Kind == "account")">Account security</option></select></div>
        <div class="form-check mb-2"><input id="mine" name="mine" type="checkbox" value="true" checked="@Model.Mine" class="form-check-input" /><label for="mine" class="form-check-label">Only my actions</label></div>
        <button type="submit" class="btn btn-primary">Apply filters</button><a asp-action="AuditLog" class="btn btn-outline-secondary">Clear</a>
    </form>
<p class="text-secondary small list-results">@ListPresentation.Summary(Model.Total, "event", !string.IsNullOrWhiteSpace(Model.Search) || Model.Mine || Model.Kind != "all")</p>
    @if (Model.Records.Count == 0) {
        <div class="empty-state"><h2 class="h5">No matching actions</h2><p>Try another event category or clear your filters.</p></div>
    } else {
        <div class="table-responsive"><table class="table module-table audit-table">
            <caption class="visually-hidden">Read-only audit history. Expand an event to review its full details.</caption>
            <thead><tr><th>Time</th><th>Performed by</th><th>Action</th><th>Target</th><th>Summary and details</th></tr></thead>
            <tbody>@foreach (var record in Model.Records) {
                var changes = AuditPresentation.Changes(record.Before, record.After).ToList();
                var targetName = AuditPresentation.TargetName(record, Model.UserNames);
                <tr>
                    <td>@UserTime.Format(record.OccurredUtc, "dd MMM yyyy")<span class="record-secondary">@UserTime.Format(record.OccurredUtc, "HH:mm:ss")</span></td>
                    <td>@(record.ActorUserId is { } actor && Model.UserNames.TryGetValue(actor, out var name) ? name : "Former user")</td>
                    <td>@record.Action</td>
                    <td>@targetName<span class="record-secondary">@AuditPresentation.Recorded(record.TargetType)</span></td>
                    <td><p class="audit-summary">@AuditPresentation.Summary(record)</p>
                        <button type="button" class="audit-toggle" data-audit-toggle aria-expanded="false" aria-controls="audit-event-@record.Id">View details<span class="visually-hidden"> for event @record.Id</span></button>
                    </td>
                </tr>
                @* ADMIN - The expanded row preserves original snapshots and shows missing legacy fields explicitly. *@
                <tr id="audit-event-@record.Id" class="audit-detail-row" hidden><td colspan="5">
                            <div class="audit-event-content">
                                <h2 class="h6">Reason / details</h2><p class="preserve-lines">@AuditPresentation.Recorded(record.Details)</p>
                                <h2 class="h6">Changes</h2>
                                @if (changes.Count == 0) { <p class="text-secondary">Not recorded</p> }
                                else { <table class="table audit-changes"><caption class="visually-hidden">Values before and after this event</caption><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>@foreach (var change in changes) { <tr><th scope="row">@change.Field</th><td class="preserve-lines">@change.Before</td><td class="preserve-lines">@change.After</td></tr> }</tbody></table> }
                                <dl class="audit-metadata">
                                    @if (targetName != AuditPresentation.Recorded(record.TargetName)) { <dt>Target name at event</dt><dd>@AuditPresentation.Recorded(record.TargetName)</dd> }
                                    <dt>Result</dt><dd>@AuditPresentation.Recorded(record.Result)</dd><dt>IP address</dt><dd>@AuditPresentation.Recorded(record.IpAddress)</dd>
                                    <dt>Device</dt><dd>@AuditPresentation.Recorded(record.Device)</dd><dt>Performed by ID</dt><dd>@AuditPresentation.Recorded(record.ActorUserId)</dd>
                                    <dt>Target ID</dt><dd>@AuditPresentation.Recorded(record.TargetId)</dd><dt>Event ID</dt><dd>@record.Id</dd>
                                    <dt>Request ID</dt><dd>@AuditPresentation.Recorded(record.CorrelationId)</dd>
                                </dl>
                            </div>
                </td></tr>
            }</tbody>
        </table></div>
    }
    <partial name="_Pagination" model='new PaginationModel(Model.Page, Model.PageCount, ListPresentation.Count(Model.Total, "event"))' />
</div>
