@model AuditLogModel
@{ ViewData["Title"] = "Audit log"; }
<div class="admin-content"><div class="page-heading"><div><h1>Audit log</h1><p class="text-secondary">Account access changes, application decisions and course administration across all administrators. Times shown in @UserTime.Id.</p></div></div>
<form method="get" class="filter-bar"><div class="filter-search"><label for="search" class="form-label">Search actions, targets or reasons</label><input id="search" name="search" value="@Model.Search" maxlength="200" class="form-control" /></div><div class="form-check mb-2"><input id="mine" name="mine" type="checkbox" value="true" checked="@Model.Mine" class="form-check-input" /><label for="mine" class="form-check-label">Only my actions</label></div><button type="submit" class="btn btn-primary">Apply filters</button><a asp-action="AuditLog" class="btn btn-outline-secondary">Clear</a></form>
@if (Model.Records.Count == 0) { <div class="empty-state"><h2 class="h5">No matching actions</h2><p>Recorded management actions appear here. Try clearing your filters.</p></div> } else { <div class="table-responsive"><table class="table module-table"><caption class="visually-hidden">Read-only administrator audit history</caption><thead><tr><th>Time</th><th>Administrator</th><th>Action</th><th>Target</th><th>Reason / details</th></tr></thead><tbody>@foreach (var record in Model.Records) { <tr><td>@UserTime.Format(record.OccurredUtc, "dd MMM yyyy, HH:mm:ss")</td><td>@(record.ActorUserId is { } actor && Model.Actors.TryGetValue(actor, out var name) ? name : "Former administrator")<span class="record-secondary">@record.ActorUserId</span></td><td>@record.Action</td><td>@record.TargetName<span class="record-secondary">@record.TargetType · @record.TargetId</span></td><td class="preserve-lines">@record.Details</td></tr> }</tbody></table></div> }
<nav class="pagination-bar" aria-label="Audit pages"><span>Page @Model.Page of @Model.PageCount</span><div class="form-actions">@if (Model.Page > 1) { <a asp-action="AuditLog" asp-route-search="@Model.Search" asp-route-mine="@Model.Mine" asp-route-page="@(Model.Page - 1)">Previous</a> } @if (Model.Page < Model.PageCount) { <a asp-action="AuditLog" asp-route-search="@Model.Search" asp-route-mine="@Model.Mine" asp-route-page="@(Model.Page + 1)">Next</a> }</div></nav></div>
