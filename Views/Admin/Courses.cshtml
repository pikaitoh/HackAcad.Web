@model CourseListModel
@{ ViewData["Title"] = "Moderate courses"; }
<div class="admin-content">
    <div class="page-heading"><div><h1>Moderate courses</h1><p class="text-secondary">Review content across all teachers. @Model.Total course(s) match your filters.</p></div></div>
    <form asp-action="Courses" method="get" class="filter-bar"><div class="filter-search"><label for="search" class="form-label">Search courses</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Course title or teacher" maxlength="256" /></div><div><label for="status" class="form-label">Publication</label><select id="status" name="status" class="form-select"><option value="">All courses</option><option value="published" selected="@(Model.Status == "published")">Published</option><option value="draft" selected="@(Model.Status == "draft")">Unpublished</option></select></div><button class="btn btn-primary" type="submit">Apply filters</button><a asp-action="Courses" class="btn btn-outline-secondary">Clear</a></form>
    @if (Model.Courses.Count == 0) { <div class="empty-state"><h2 class="h5">No courses found</h2><p>Teacher-created courses will appear here for moderation. Clear your filters to see all courses.</p></div> }
    else { <div class="table-responsive"><table class="table align-middle module-table"><caption class="visually-hidden">Courses from all teachers</caption><thead><tr><th scope="col">Course</th><th scope="col">Teacher</th><th scope="col">Publication</th><th scope="col">Enrolments</th><th scope="col">Actions</th></tr></thead><tbody>@foreach (var course in Model.Courses) { <tr><td><span class="fw-semibold">@course.Title</span><span class="record-secondary">@(course.Category ?? "Uncategorised")</span></td><td>@course.Teacher</td><td>@(course.IsPublished ? "Published" : "Unpublished")</td><td>@course.Enrollments</td><td><div class="table-actions"><a asp-action="EditCourse" asp-route-id="@course.CourseId" aria-label="Review @course.Title">Review</a><a asp-action="DeleteCourse" asp-route-id="@course.CourseId" class="text-danger" aria-label="Delete @course.Title">Delete</a></div></td></tr> }</tbody></table></div> }
    <nav class="pagination-bar" aria-label="Course pages"><span>Page @Model.Page of @Model.PageCount</span><div class="d-flex gap-3">@if (Model.Page > 1) { <a asp-action="Courses" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Previous</a> } @if (Model.Page < Model.PageCount) { <a asp-action="Courses" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Next</a> }</div></nav>
</div>
