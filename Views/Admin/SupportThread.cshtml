@* ADMIN - Admin conversation: public replies and internal notes have different visibility and notification rules. *@
@model SupportThreadModel
@{ ViewData["Title"] = $"Support request #{Model.Ticket.Id}"; ViewData["SupportAdmin"] = true; }
<div class="admin-content support-thread"><div class="page-heading"><div><h1>@Model.Ticket.Subject</h1><p class="text-secondary">Request #@Model.Ticket.Id · @Model.Ticket.Category · Times shown in @UserTime.Id.</p></div><a asp-action="SupportRequests" class="btn btn-outline-secondary">Back to requests</a></div>
<section class="surface-panel mb-4"><div class="page-heading"><div><h2 class="h5">@Model.DisplayName</h2><p>@Model.Email</p></div><span class="support-status" data-status="@Model.Ticket.Status">@Model.Ticket.Status</span></div>
@if (Model.AccountContext is { } account) { <partial name="_AdminAccountContext" model="account" /> }
<a asp-action="UserDetails" asp-route-id="@Model.Ticket.UserId" class="btn btn-outline-secondary">Review account access</a>
@if (Model.AccessChanges.Count > 0) { <details class="mt-3"><summary>Account access history</summary><ul class="access-history">@foreach (var item in Model.AccessChanges) { <li><strong>@item.Action</strong> · @UserTime.Format(item.OccurredUtc,"dd MMM yyyy, HH:mm:ss")<p>@item.Details</p></li> }</ul></details> }
<p class="form-text">A reply or a resolved request does not reactivate an account. Change access separately after verifying the case.</p></section>
@if (Model.AccountContext is { } context) { <partial name="_AdminSignInActivity" model="context.Activity" /> }
<section class="surface-panel"><h2 class="h5">Conversation</h2><partial name="_SupportMessages" model="Model.Messages" />
@if (Model.Ticket.Status == "Resolved") { <p class="support-waiting" role="status">This request has been resolved. The conversation is read-only.</p> }
</section>
@* ADMIN - Internal notes stay private and preserve public status; a public reply can notify the requester. *@
@if (Model.Ticket.Status != "Resolved") {
<section class="surface-panel mt-4"><h2 class="h5">Add a reply or internal note</h2><form data-admin-operation asp-action="SupportReply" asp-route-id="@Model.Ticket.Id" method="post" data-validated-form novalidate>
<input type="hidden" name="Version" value="@Model.Ticket.Version" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<label for="Body" class="form-label">Message</label><textarea id="Body" name="Body" class="form-control" rows="5" required minlength="10" maxlength="3000" data-trim data-val-required="Please enter a message." data-val-length="Please enter between 10 and 3,000 characters." aria-describedby="message-help Body-error">@Model.Input.Body</textarea><span id="Body-error" class="field-error" data-valmsg-for="Body" aria-live="polite">@ViewData.ModelState["Body"]?.Errors.FirstOrDefault()?.ErrorMessage</span><p id="message-help" class="form-text">Public replies appear in the user's conversation and trigger an email notification. Internal notes stay private to administrators and keep the current request status.</p>
<div class="form-check mb-3"><input id="Internal" name="Internal" type="checkbox" value="true" checked="@Model.Input.Internal" class="form-check-input" /><label for="Internal" class="form-check-label">Internal note only</label></div>
<label for="Status" class="form-label">Request status after a public reply</label><select id="Status" name="Status" class="form-select mb-4">@foreach (var status in new[] { "Awaiting admin", "Awaiting user", "Resolved" }) { <option selected="@(status == (Model.Input.Status ?? "Awaiting user"))">@status</option> }</select>
<button class="btn btn-primary">Save message</button></form></section>
}
</div>
