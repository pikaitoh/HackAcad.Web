@model UserRow
@{ ViewData["Title"] = "Delete account"; }
<div class="admin-content">
    <div class="form-measure"><h1>Delete account</h1><p>You are deleting <strong>@Model.DisplayName</strong> (@Model.Email).</p><p>The account, its enrolments, learning progress and submissions will be permanently removed. Courses owned by a Teacher prevent account deletion.</p><p>You can <a asp-action="EditUser" asp-route-id="@Model.Id">disable the account</a> to preserve its records.</p>
        <form asp-action="DeleteUser" asp-route-id="@Model.Id" method="post" data-account-form>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="mb-4">
                <label for="emailConfirmation" class="form-label">Type @Model.Email to confirm</label>
                <input id="emailConfirmation" name="emailConfirmation" value="@(ViewData.ModelState["emailConfirmation"]?.AttemptedValue)" class="form-control @(ViewData.ModelState["emailConfirmation"]?.Errors.Count > 0 ? "input-validation-error" : "")" type="text" inputmode="email" autocomplete="off" spellcheck="false" maxlength="256" required data-trim data-val="true" data-val-required="Enter the account's email address to confirm deletion." data-val-match="Enter the account's email address to confirm deletion." data-val-match-value="@Model.Email" aria-invalid="@(ViewData.ModelState["emailConfirmation"]?.Errors.Count > 0 ? "true" : null)" aria-describedby="emailConfirmation-error" />
                @Html.ValidationMessage("emailConfirmation", null, new { id = "emailConfirmation-error", @class = "field-error", aria_live = "polite" })
            </div>
            <div class="form-actions"><button class="btn btn-danger" type="submit">Delete account permanently</button><a asp-action="Users" class="btn btn-outline-secondary">Cancel</a></div>
        </form>
    </div>
</div>
