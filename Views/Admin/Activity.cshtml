@model AdminActivityModel
@{ ViewData["Title"] = "My admin activity"; }
<div class="admin-content">
    <div class="page-heading"><div><h1>My admin activity</h1><p class="text-secondary">Your successful account and course management actions. Times shown in @UserTime.Id.</p></div></div>
    @if (Model.Records.Count == 0) { <div class="empty-state"><h2>No activity recorded yet</h2><p>Actions you complete from now on will appear here.</p></div> }
    else
    {
        <div class="table-responsive" tabindex="0" role="region" aria-label="Your Admin activity; scroll horizontally as needed"><table class="table module-table"><caption class="visually-hidden">Successful administration actions performed by you</caption><thead><tr><th scope="col">Time</th><th scope="col">Action</th><th scope="col">Account or course</th><th scope="col">Details</th></tr></thead><tbody>
        @foreach (var record in Model.Records) { <tr><td>@UserTime.Format(record.OccurredUtc, "dd MMM yyyy, HH:mm:ss")</td><td>@record.Action</td><td>@record.TargetName<span class="record-secondary">@record.TargetType · @record.TargetId</span></td><td>@record.Details</td></tr> }
        </tbody></table></div>
        <nav class="pagination-bar" aria-label="Admin activity pages"><span>Page @Model.Page of @Math.Max(1, (int)Math.Ceiling(Model.Total / 20d))</span><div class="form-actions">@if (Model.Page > 1) { <a asp-action="Activity" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary btn-sm">Previous</a> } @if (Model.Page * 20 < Model.Total) { <a asp-action="Activity" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary btn-sm">Next</a> }</div></nav>
    }
</div>
