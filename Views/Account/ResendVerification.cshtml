@model ResendVerificationModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Resend verification email"; }
<h1 id="auth-title">Verify your email</h1>
<p class="text-secondary mb-4">Enter the email you used for your account. We'll send a new link if it still needs verification.</p>
@if (TempData["VerificationRequested"] is true)
{
    <div class="alert alert-success" role="status">If this account needs verification and can receive email, a link will arrive shortly. Check your spam folder. Allow a minute before trying again; if nothing arrives, contact an administrator.</div>
}
<form asp-action="ResendVerification" method="post" data-account-form>
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" data-trim class="form-control" type="email" autocomplete="email" maxlength="256" required autofocus aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" aria-describedby="Email-error" />
        <span id="Email-error" asp-validation-for="Email" class="field-error" aria-live="polite"></span>
    </div>
    <button class="btn btn-primary w-100" type="submit">Send verification email</button>
</form>
<p class="mt-4 mb-0"><a asp-action="Login">Back to log in</a></p>
