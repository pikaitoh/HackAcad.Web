@model LoginHistoryModel
@{ ViewData["Title"] = "Login history"; Layout = "_ManageAccountLayout"; }
<div class="account-panel">
    <div class="page-heading"><div><h1>Login history</h1><p class="text-secondary">Sign-in attempts for your account. Times shown in @UserTime.Id.</p></div></div>
    @if (Model.Records.Count == 0) { <div class="empty-state"><h2>No sign-ins recorded yet</h2><p>Your next sign-in will appear here.</p></div> }
    else
    {
        <div class="table-responsive login-history-table" role="region" aria-label="Your login history"><table class="table module-table"><caption class="visually-hidden">Sign-in attempts for your account</caption><thead><tr><th scope="col">Time</th><th scope="col">Device</th><th scope="col">IP address</th><th scope="col">Result</th></tr></thead><tbody>
        @foreach (var record in Model.Records) { <tr><td>@UserTime.Format(record.OccurredUtc, "dd MMM yyyy, HH:mm:ss")</td><td>@record.Device</td><td>@record.IpAddress</td><td><span class="status-label @(record.Outcome.StartsWith("Signed in") ? "status-active" : "status-disabled")">@record.Outcome</span></td></tr> }
        </tbody></table></div>
        <partial name="_Pagination" model='new PaginationModel(Model.Page, Math.Max(1, (int)Math.Ceiling(Model.Total / 20d)))' />
    }
</div>
