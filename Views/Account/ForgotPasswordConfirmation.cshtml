@{ ViewData["Title"] = "Check your email"; Layout = "_AuthLayout"; }
<h1 id="auth-title">Check your email</h1>
<p class="text-secondary">If the email belongs to an eligible account, you'll receive a password reset link.</p>
<p>The link expires in 10 minutes. Check your spam folder if it hasn't arrived.</p>
<p class="form-text">You can request another link once a minute. If it still doesn't arrive, check your email address or contact an administrator.</p>
<div class="form-actions mt-4"><a asp-action="Login" class="btn btn-primary">Back to log in</a><a asp-action="ForgotPassword" class="btn btn-outline-secondary">Try again</a></div>
