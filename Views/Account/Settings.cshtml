@model AccountSettingsModel
@{ ViewData["Title"] = "Email address"; Layout = "_ManageAccountLayout"; }
<div class="account-panel">
    <div class="page-heading"><div><h1>Email address</h1><p class="text-secondary">Manage the email you use to sign in.</p></div></div>
    <section class="form-measure email-settings" aria-labelledby="email-title">
        <h2 id="email-title">Your email</h2>
        <dl class="detail-list"><dt>Email address</dt><dd class="text-break">@Model.Email</dd><dt>Verification status</dt><dd><span class="status-label @(Model.EmailConfirmed ? "status-active" : "status-disabled")">@(Model.EmailConfirmed ? "Verified" : "Not verified")</span></dd></dl>
        <p class="text-secondary">Your current email stays in use until you confirm a new one. Changing it does not disconnect Google or GitHub.</p>
        <div class="form-actions"><a asp-action="ChangeEmail" class="btn btn-primary">Change email</a>
        @if (!Model.EmailConfirmed) { <a asp-action="ResendVerification" class="btn btn-outline-secondary">Resend verification email</a> }
        </div>
    </section>
    <section class="form-measure mt-4" aria-labelledby="external-title">
        <h2 id="external-title">Connected accounts</h2>
        @if (TempData["Error"] is string error) { <p class="field-error" role="alert">@error</p> }
        <p class="text-secondary">Use a connected account to sign in. New connections must use your verified HackAcad email; existing connections stay linked when that email changes.</p>
        @inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> ExternalSignIn
        @{ var available = (await ExternalSignIn.GetExternalAuthenticationSchemesAsync()).Select(s => s.Name).ToHashSet(); }
        @foreach (var provider in ExternalAuthentication.Providers) {
            var account = Model.ConnectedAccounts.FirstOrDefault(a => a.Provider == provider);
            <div class="connected-provider">
                <div class="connected-provider-identity">
                    <div class="connected-provider-name"><partial name="_ProviderMark" model="provider" /><h3 class="h6">@provider</h3></div>
                    @if (account is not null) {
                        @if (!string.IsNullOrEmpty(account.Email)) { <p class="form-text">@account.Email</p> }
                        @if (!string.IsNullOrEmpty(account.Name) && account.Name != account.Email) { <p class="form-text">@account.Name</p> }
                        @if (string.IsNullOrEmpty(account.Email) && string.IsNullOrEmpty(account.Name)) { <p class="form-text">Account details will appear after your next @provider sign-in.</p> }
                    }
                </div>
                <div class="connected-provider-actions">
                @if (account is not null) {
                    <span class="status-label status-active">Connected</span>
                    <a asp-action="Disconnect" asp-route-provider="@provider" class="btn btn-outline-secondary btn-sm" aria-label="Disconnect @provider">Disconnect</a>
                }
                else if (available.Contains(provider)) {
                    <form asp-action="ExternalLogin" asp-route-provider="@provider" method="post"><input type="hidden" name="connect" value="true" /><button type="submit" class="btn btn-outline-secondary btn-sm">Connect @provider</button></form>
                } else { <span class="form-text">Currently unavailable</span> }
                </div>
            </div>
        }
    </section>
</div>
