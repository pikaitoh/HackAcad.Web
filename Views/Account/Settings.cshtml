@model AccountSettingsModel
@{ ViewData["Title"] = "Email address"; Layout = "_ManageAccountLayout"; }
<div class="account-panel">
    <div class="page-heading"><div><h1>Email address</h1><p class="text-secondary">Manage the email you use to sign in.</p></div></div>
    <section class="form-measure email-settings" aria-labelledby="email-title">
        <h2 id="email-title">Your email</h2>
        <dl class="detail-list"><dt>Email address</dt><dd class="text-break">@Model.Email</dd><dt>Verification status</dt><dd><span class="status-label @(Model.EmailConfirmed ? "status-active" : "status-disabled")">@(Model.EmailConfirmed ? "Verified" : "Not verified")</span></dd></dl>
        <p class="text-secondary">When you change your email, your current address stays in use until you confirm the new one.</p>
        <div class="form-actions"><a asp-action="ChangeEmail" class="btn btn-primary">Change email</a>
        @if (!Model.EmailConfirmed) { <a asp-action="ResendVerification" class="btn btn-outline-secondary">Resend verification email</a> }
        </div>
    </section>
</div>
