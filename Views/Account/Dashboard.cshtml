@model DashboardModel
@{ ViewData["Title"] = "My account"; }
<div class="container module-shell">
    <div class="page-heading">
        <div><h1>Hello, @Model.DisplayName</h1><p class="text-secondary">Your HackAcad account and learning activity.</p></div>
        <a class="btn btn-outline-dark" asp-action="Profile">Edit profile</a>
    </div>
    <p class="mb-4">Signed in as <span class="role-badge">@Model.Role</span></p>
    <section aria-labelledby="learning-title">
        <h2 id="learning-title" class="h4">Learning activity</h2>
        <dl class="activity-summary">
            <div><dt>Course enrolments</dt><dd>@Model.EnrollmentCount</dd></div>
            <div><dt>Activities completed</dt><dd>@Model.CompletedActivities</dd></div>
            <div><dt>Challenges solved</dt><dd>@Model.SolvedChallenges</dd></div>
        </dl>
        @if (Model.EnrollmentCount == 0) { <p class="text-secondary">Your course enrolments and completed activities will appear here as you learn.</p> }
    </section>
    @if (User.IsInRole(AccountRoles.Admin))
    {
        <section class="account-next-step"><h2 class="h4">Platform administration</h2><p>Manage accounts, review platform activity and moderate courses.</p><a class="btn btn-dark" asp-controller="Admin" asp-action="Index">Open admin overview</a></section>
    }
</div>
