@model EnableAuthenticatorModel
@{ ViewData["Title"] = "Connect authenticator"; }
<div class="container module-shell"><div class="page-heading"><div><h1>Connect your authenticator</h1><p class="text-secondary">Setup expires after 10 minutes. Keep this QR code and key private.</p></div><a asp-action="TwoFactor" class="btn btn-outline-secondary">Cancel setup</a></div>
<section class="form-measure"><h2>1. Add HackAcad to your app</h2><p>Scan this QR code with your authenticator app.</p><img src="@Model.QrImage" width="240" height="240" class="authenticator-qr" alt="QR code to add your HackAcad account to an authenticator app" />
<p class="form-text">Can't scan? Choose to enter a setup key in the app. Select a time-based code.</p><code class="authenticator-key">@Model.SharedKey</code>
<h2 class="mt-4">2. Enter the code from your app</h2>
<form asp-action="EnableAuthenticator" method="post" data-validated-form><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="mb-4"><label asp-for="Code" class="form-label">Six-digit code</label><input asp-for="Code" aria-invalid="@(ViewData.ModelState["Code"]?.Errors.Count > 0 ? "true" : null)" class="form-control otp-input" autocomplete="one-time-code" inputmode="numeric" minlength="6" maxlength="6" required aria-describedby="Code-error" /><span id="Code-error" asp-validation-for="Code" class="field-error" aria-live="polite"></span></div><button type="submit" class="btn btn-primary">Verify and turn on 2FA</button></form>
</section></div>
