@model bool
@{ Layout = "_AuthLayout"; ViewData["Title"] = Model ? "Email verified" : "Verification link unavailable"; }
@if (Model)
{
    <h1 id="auth-title">Email verified</h1>
    <p class="text-secondary mb-4">Your email is verified. You can now log in to HackAcad.</p>
    <a asp-action="Login" class="btn btn-primary">Log in</a>
}
else
{
    <h1 id="auth-title">This link isn't available</h1>
    <p class="text-secondary mb-4">The link may have expired or no longer match your account. Request a new verification email. If your account is disabled, contact an administrator.</p>
    <a asp-action="ResendVerification" class="btn btn-primary">Request a new link</a>
    <p class="mt-4 mb-0"><a asp-action="Login">Back to log in</a></p>
}
