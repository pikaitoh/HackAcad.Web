@model ProfileModel
@{ ViewData["Title"] = "My profile"; ViewData["AccountArea"] = "profile"; }
<div class="container module-shell">
    <div class="page-heading"><div><h1>My profile</h1><p class="text-secondary">Manage your picture, username and full name.</p></div></div>
    <div class="profile-layout">
        <section aria-labelledby="picture-title">
            <div class="profile-photo">
                @if (Model.HasAvatar) { <img class="profile-avatar" src="@Url.Action("Avatar")" width="112" height="112" alt="Your profile picture" /> }
                else { <span class="profile-avatar avatar-initial" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.DisplayName) ? "H" : System.Globalization.StringInfo.GetNextTextElement(Model.DisplayName).ToUpperInvariant())</span> }
                <div><h2 class="h4" id="picture-title">Profile picture</h2><p class="form-text mb-0">A photo or an image that represents you.</p></div>
            </div>
            <form id="avatar-upload-form" asp-action="UploadAvatar" method="post" enctype="multipart/form-data" data-validated-form class="avatar-upload">
                <label for="avatar" class="form-label">Choose a picture</label>
                <input id="avatar" name="avatar" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" required data-val="true" data-val-required="Choose a picture to upload." data-file-max-size="2097152" aria-describedby="avatar-help avatar-error" aria-invalid="@(ViewData.ModelState["avatar"]?.Errors.Count > 0 ? "true" : null)" />
                <p id="avatar-help" class="form-text">JPG, PNG or WebP. Up to 2 MB and 4,096 × 4,096 pixels. Your picture will be cropped to a square.</p>
                @Html.ValidationMessage("avatar", null, new { id = "avatar-error", @class = "field-error", aria_live = "polite" })
            </form>
            <div class="form-actions">
                <button type="submit" form="avatar-upload-form" class="btn btn-outline-secondary btn-sm">Upload picture</button>
                @if (Model.HasAvatar) { <form asp-action="RemoveAvatar" method="post"><button type="submit" class="btn btn-outline-danger btn-sm">Remove picture</button></form> }
            </div>
        </section>
        <section class="form-measure profile-details" aria-labelledby="details-title">
            <h2 class="h4" id="details-title">Profile details</h2>
            <dl class="detail-list profile-facts">
                <div><dt>Role</dt><dd><span class="role-badge" data-role="@Model.Role">@Model.Role</span></dd></div>
                <div><dt>Joined</dt><dd>@Model.JoinedDate.ToString("dd MMM yyyy") <span class="text-secondary">(UTC)</span></dd></div>
            </dl>
            <form asp-action="Profile" method="post" data-account-form class="profile-name-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="mb-4">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" data-trim aria-invalid="@(ViewData.ModelState["DisplayName"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="nickname" minlength="2" maxlength="50" required  aria-describedby="DisplayName-help DisplayName-error" />
                <p id="DisplayName-help" class="form-text">2–50 characters. Use letters, numbers, spaces, . _ - or apostrophes.</p><span id="DisplayName-error" asp-validation-for="DisplayName" class="field-error" aria-live="polite"></span>
            </div>
            <div class="mb-4">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" data-trim class="form-control" autocomplete="name" maxlength="100" aria-invalid="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "true" : null)" aria-describedby="FullName-help FullName-error" />
                <p id="FullName-help" class="form-text">Optional. Up to 100 characters.</p><span id="FullName-error" asp-validation-for="FullName" class="field-error" aria-live="polite"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save profile</button>
            </form>
        </section>
    </div>
</div>
