@model ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; Layout = "_AuthLayout"; }
@if (Model.InvalidLink)
{
    <h1 id="auth-title">This reset link isn't valid</h1><p class="text-secondary">It may have expired, already been used, or your account details may have changed.</p>
    <a asp-action="ForgotPassword" class="btn btn-primary">Request a new reset link</a>
}
else
{
<h1 id="auth-title">Choose a new password</h1><p class="text-secondary">Use your reset link within 10 minutes of requesting it. You'll log in again after changing your password.</p>
<form asp-action="ResetPassword" method="post" data-account-form>
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" required aria-describedby="NewPassword-error password-help" /><span id="NewPassword-error" asp-validation-for="NewPassword" class="field-error" aria-live="polite"></span><p id="password-help" class="form-text">8–100 characters, with uppercase and lowercase letters, a number and a symbol.</p></div>
<div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required aria-describedby="ConfirmPassword-error" /><span id="ConfirmPassword-error" asp-validation-for="ConfirmPassword" class="field-error" aria-live="polite"></span></div>
<button type="submit" class="btn btn-primary w-100">Reset password</button></form>

}
