@model ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; Layout = "_AuthLayout"; }
<h1 id="auth-title">Forgot password?</h1>
<p class="text-secondary">Enter your account email. We'll send you a link to reset your password.</p>
<form asp-action="ForgotPassword" method="post" data-validated-form>
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="256" required autofocus data-trim aria-describedby="Email-error" aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" /><span id="Email-error" asp-validation-for="Email" class="field-error" aria-live="polite"></span></div>
<button type="submit" class="btn btn-primary w-100">Send reset link</button></form>
<p class="mt-4 mb-0"><a asp-action="Login">Back to log in</a></p>
<p class="form-text mt-4">Registered with Google and haven't set a HackAcad password? Use Continue with Google to log in.</p>
