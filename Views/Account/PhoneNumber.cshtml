@model AccountSettingsModel
@{ ViewData["Title"] = "Phone number"; Layout = "_ManageAccountLayout"; }
<div class="account-panel">
    <div class="page-heading"><div><h1>Phone number</h1><p class="text-secondary">Manage your verified phone number.</p></div></div>
    <section class="form-measure phone-settings" aria-labelledby="phone-title">
        <h2 id="phone-title">Your phone number</h2>
        <dl class="detail-list">
            <dt>Phone number</dt><dd class="text-break">@(string.IsNullOrEmpty(Model.CurrentPhone) ? "No phone number added" : Model.CurrentPhone)</dd>
            <dt>Verification status</dt><dd><span class="status-label @(Model.PhoneConfirmed ? "status-active" : "status-disabled")">@(Model.PhoneConfirmed ? "Verified" : string.IsNullOrEmpty(Model.CurrentPhone) ? "Not added" : "Not verified")</span></dd>
        </dl>
        <p class="text-secondary">Use your verified number with your password to log in or set up SMS two-factor authentication. Password recovery uses your account email. Your current number stays in use until you verify a replacement.</p>
        @if (Model.PendingPhone is not null) { <p class="text-secondary">Verification is pending for <strong>@Model.PendingPhone</strong>.</p> }
        <div class="form-actions">
            <a asp-action="ChangePhone" class="btn btn-primary">@(Model.PendingPhone is not null ? "Continue verification" : Model.CurrentPhone is null ? "Add phone number" : "Change phone number")</a>
            @if (!string.IsNullOrEmpty(Model.CurrentPhone)) { <a asp-action="RemovePhone" class="btn btn-outline-danger">Remove phone number</a> }
        </div>
    </section>
</div>
