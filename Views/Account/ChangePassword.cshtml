@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; Layout = "_ManageAccountLayout"; }
<div class="account-panel">
    <h1>Change password</h1>
    <p class="text-secondary mb-4">Other signed-in sessions will need to log in again.</p>
    <form asp-action="ChangePassword" method="post" data-account-form class="form-measure">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" aria-invalid="@(ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="current-password" required  aria-describedby="CurrentPassword-error" /><span id="CurrentPassword-error" asp-validation-for="CurrentPassword" class="field-error" aria-live="polite"></span></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" aria-invalid="@(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" aria-describedby="password-help NewPassword-error" required />
            <p id="password-help" class="form-text">Use 8–100 characters with uppercase, lowercase, a number and a symbol.</p><span id="NewPassword-error" asp-validation-for="NewPassword" class="field-error" aria-live="polite"></span>
        </div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" aria-invalid="@(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="new-password" required  aria-describedby="ConfirmPassword-error" /><span id="ConfirmPassword-error" asp-validation-for="ConfirmPassword" class="field-error" aria-live="polite"></span></div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Change password</button><a asp-action="Settings" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
