@model TwoFactorLoginModel
@{ ViewData["Title"] = "Two-factor authentication"; Layout = "_AuthLayout"; }
<h1 id="auth-title">Two-factor authentication</h1><p class="text-secondary">Enter the current six-digit code from your authenticator app.</p>
<form asp-action="LoginTwoFactor" method="post" data-validated-form><input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" />
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="mb-4"><label asp-for="Code" class="form-label">Authenticator code</label><input asp-for="Code" aria-invalid="@(ViewData.ModelState["Code"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="one-time-code" inputmode="numeric" minlength="6" maxlength="6" required aria-describedby="Code-error" /><span id="Code-error" asp-validation-for="Code" class="field-error" aria-live="polite"></span></div><button type="submit" class="btn btn-primary w-100">Sign in</button></form>
<div class="security-links flex-nowrap mt-4"><a asp-action="LoginRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary w-50">Use a recovery code</a><a asp-action="Login" class="btn btn-outline-secondary w-50">Back to log in</a></div>
