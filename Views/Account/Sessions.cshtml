@model SessionsModel
@{ ViewData["Title"] = "Devices & sessions"; Layout = "_ManageAccountLayout"; }
<div class="account-panel account-sessions">
    <div class="page-heading"><div><h1>Devices &amp; sessions</h1><p class="text-secondary">Manage where you're signed in. Times shown in @UserTime.Id.</p></div></div>
    <p class="security-explanation">Review your signed-in browsers and devices. Device names are estimates; a listed device may be offline.</p>
    <form asp-action="Sessions" method="post" data-validated-form class="session-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        @if (Model.Sessions.Any(s => s.Id != Model.CurrentSessionId)) { <div class="session-password"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" aria-invalid="@(ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="current-password" required aria-describedby="session-password-help CurrentPassword-error" /><p id="session-password-help" class="form-text">Confirm your password before signing out another device. This device stays signed in.</p><span id="CurrentPassword-error" asp-validation-for="CurrentPassword" class="field-error" aria-live="polite"></span></div> }
        <div class="session-list">
        @foreach (var session in Model.Sessions)
        {
            var current = session.Id == Model.CurrentSessionId;
            <article class="session-row"><div><h2>@session.Device @if (current) { <span class="role-badge">This device</span> }</h2><dl class="session-facts"><div><dt>IP address</dt><dd>@session.IpAddress</dd></div><div><dt>Signed in</dt><dd>@UserTime.Format(session.CreatedUtc, "dd MMM yyyy, HH:mm")</dd></div><div><dt>Last activity</dt><dd>@UserTime.Format(session.LastSeenUtc, "dd MMM yyyy, HH:mm")</dd></div></dl></div>
            @if (!current) { <button type="submit" name="sessionId" value="@session.Id" class="btn btn-outline-danger btn-sm" aria-label="Sign out @session.Device, signed in @UserTime.Format(session.CreatedUtc, "dd MMM yyyy HH:mm")">Sign out</button> }
            </article>
        }
        </div>
        @if (Model.Sessions.Count > 1) { <button type="submit" class="btn btn-outline-danger">Sign out all other devices</button> }
        else { <p class="text-secondary session-only">You're only signed in on this device.</p> }
    </form>
</div>
