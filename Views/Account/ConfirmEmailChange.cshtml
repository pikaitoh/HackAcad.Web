@model bool
@{ ViewData["Title"] = Model ? "Email changed" : "Email change unavailable"; }
<div class="container module-shell form-measure">
    @if (Model)
    {
        <h1>Email changed</h1><p class="text-secondary mb-4">Your new email is verified and ready to use. Log in again with the new address.</p>
        <a asp-action="Login" class="btn btn-primary">Log in</a>
    }
    else
    {
        <h1>This link isn't available</h1><p class="text-secondary mb-4">It may have expired, already been used, or no longer match your account. Your email has not been changed by this request. Log in and request a new link from your profile. If your account is disabled, contact an administrator.</p>
        <a asp-action="Profile" class="btn btn-primary">Go to profile</a>
    }
</div>
