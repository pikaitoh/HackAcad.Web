@model LoginModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Log in"; }
<h1 id="auth-title">Welcome back</h1>
<p class="text-secondary mb-4">Log in to your HackAcad account.</p>
@if (TempData["ExternalNotice"] is string notice) { <p class="google-notice" role="status">@notice</p> }
<partial name="_ExternalLogin" model="@(Model.ReturnUrl ?? string.Empty)" />
<form asp-action="Login" method="post" data-account-form>
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" data-trim aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" class="form-control" type="text" autocomplete="username" maxlength="256" required autofocus  aria-describedby="Email-error login-identifier-help" />
        <span id="Email-error" asp-validation-for="Email" class="field-error" aria-live="polite"></span>
        <p id="login-identifier-help" class="form-text">For phone login, use your verified number with its country code, such as +60123456789.</p>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : null)" class="form-control" autocomplete="current-password" required  aria-describedby="Password-error" />
        <span id="Password-error" asp-validation-for="Password" class="field-error" aria-live="polite"></span>
    </div>
    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button class="btn btn-primary w-100" type="submit">Log in</button>
</form>
<p class="mt-3 mb-0"><a asp-action="ForgotPassword">Forgot password?</a></p>
<p class="mt-4 mb-0">New to HackAcad? <a asp-action="Register">Create an account</a></p>
