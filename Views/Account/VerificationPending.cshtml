@model string
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Verify your email"; }
<h1 id="auth-title">Check your email</h1>
<p>Verify <strong class="text-break">@Model</strong> to finish creating your account.</p>
@if (TempData["VerificationDeliveryFailed"] is true)
{
    <div class="alert alert-danger" role="alert">We couldn't send the verification email. Try again below. If it still doesn't arrive, contact an administrator.</div>
}
else if (TempData["VerificationRequested"] is true)
{
    <div class="alert alert-success" role="status">Verification email requested. Check your inbox and spam folder. Allow a minute before requesting another email.</div>
}
<p class="text-secondary mb-4">Open the link in your HackAcad verification email. The link expires in 10 minutes. Check your spam folder if you don't see it.</p>
<form asp-action="ResendVerification" method="post" class="mb-3" data-account-form>
    <button type="submit" class="btn btn-primary w-100">Resend verification email</button>
</form>
<p class="text-secondary">You can request another email once a minute.</p>
<a asp-action="Login" class="btn btn-outline-secondary">Go to log in</a>
