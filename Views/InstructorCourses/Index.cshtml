@model InstructorDashboardViewModel
@{
    ViewData["Title"] = "Instructor Studio";
}

<div class="container module-shell">
    <div class="page-heading">
        <div>
            <h1>Instructor Studio</h1>
            <p class="text-secondary">Author cybersecurity courses, craft custom CTFs, and design simulated terminal labs.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.35rem; vertical-align:-2px;"><path d="M12 5v14M5 12h14"/></svg>Create New Course
        </a>
    </div>

    <!-- Instructor Metrics Summary -->
    <div class="surface-panel mb-4 p-4">
        <dl class="activity-summary">
            <div>
                <dt>My Courses</dt>
                <dd>@Model.Courses.Count</dd>
            </div>
            <div>
                <dt>Total Enrolled Students</dt>
                <dd>@Model.TotalStudentsEnrolled</dd>
            </div>
            <div>
                <dt>CTF Submissions Received</dt>
                <dd>@Model.TotalSubmissionsReceived</dd>
            </div>
        </dl>
    </div>

    <!-- Course Management Table -->
    <div class="surface-panel p-4">
        <div class="section-heading mb-3">
            <h2>Your Created Courses</h2>
            <span class="text-secondary">Manage curriculum and student progress</span>
        </div>

        @if (Model.Courses.Count == 0)
        {
            <div class="empty-state text-center p-5">
                <h3>You haven't created any courses yet.</h3>
                <p class="text-secondary">Start sharing your cybersecurity knowledge by building your first course.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">Create First Course</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle module-table">
                    <thead>
                        <tr>
                            <th scope="col">Course Title</th>
                            <th scope="col">Category</th>
                            <th scope="col">Curriculum</th>
                            <th scope="col">Enrolments</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Courses)
                        {
                            var c = row.Course;
                            <tr>
                                <td>
                                    <strong><a asp-action="Curriculum" asp-route-id="@c.CourseId">@c.Title</a></strong>
                                    <div class="record-secondary">Created: @UserTime.Format(c.CreatedDate, "dd MMM yyyy") (@UserTime.Id)</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">@(c.Category ?? "General")</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span>@row.LessonCount Lessons</span> •
                                        <span>@row.ChallengeCount CTFs</span> •
                                        <span>@row.SimulationCount Labs</span>
                                    </div>
                                </td>
                                <td>
                                    <strong>@row.EnrolledStudentsCount</strong> students
                                    <div class="record-secondary">@row.CompletedStudentsCount completed</div>
                                </td>
                                <td>
                                    @if (c.IsPublished)
                                    {
                                        <span class="status-label status-active"><span class="status-dot"></span>Published</span>
                                    }
                                    else
                                    {
                                        <span class="status-label status-disabled"><span class="status-dot"></span>Draft</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Curriculum" asp-route-id="@c.CourseId" class="btn btn-sm btn-primary">
                                            Curriculum
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.CourseId" class="btn btn-sm btn-outline-secondary">
                                            Settings
                                        </a>
                                        <form asp-action="TogglePublish" asp-route-id="@c.CourseId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                @(c.IsPublished ? "Unpublish" : "Publish")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
