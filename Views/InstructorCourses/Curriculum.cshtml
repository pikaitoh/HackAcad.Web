@model CourseCurriculumViewModel
@{
    ViewData["Title"] = $"Curriculum: {Model.Course.Title}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/terminal-dialogs.css" asp-append-version="true" />
}

<div class="container module-shell">
    @if (TempData["CourseError"] is string courseError) { <div class="alert alert-warning" role="alert">@courseError</div> }
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to Instructor Studio</a>
    </div>

    <!-- Course Header Bar -->
    <div class="workspace-start mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge mb-2" style="background:#f2cf45; color:#193e46; font-weight:700;">@(Model.Course.Category ?? "Domain")</span>
                <h1 style="color:white; font-size:1.85rem; font-weight:800; margin-bottom:0.35rem;">@Model.Course.Title</h1>
                <div style="color:var(--ha-on-dark); font-size:0.875rem;">
                    <span>Status: <strong>@(Model.Course.IsPublished ? "Published" : "Draft")</strong></span>
                    <span class="mx-2">•</span>
                    <span>@Model.Lessons.Count Lessons</span>
                    <span class="mx-2">•</span>
                    <span>@Model.Challenges.Count CTFs</span>
                    <span class="mx-2">•</span>
                    <span>@Model.SimulationTasks.Count Labs</span>
                    <span class="mx-2">•</span>
                    <span>@Model.EnrolledStudents.Count Enrolled</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.CourseId" class="btn btn-outline-light" target="_blank">
                    Preview Student View ↗
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Course.CourseId" class="btn btn-primary">
                    Edit Settings
                </a>
                <a asp-action="ReviewTimeline"
                    asp-route-id="@Model.Course.CourseId"
                    class="btn btn-outline-light">
                        Review Timeline
                </a>
            </div>
        </div>
    </div>

    <partial name="_CourseReview" model="Model.Course" />

    <!-- Nav Tabs for Curriculum Modules -->
    <ul class="nav nav-pills mb-4" id="curriculumTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active d-inline-flex align-items-center gap-1" id="lessons-tab" data-bs-toggle="pill" data-bs-target="#lessons-content" type="button" role="tab">
                <img src="/images/file.svg" class="sim-icon me-1" alt="" /> Lessons (@Model.Lessons.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-inline-flex align-items-center gap-1" id="challenges-tab" data-bs-toggle="pill" data-bs-target="#challenges-content" type="button" role="tab">
                <img src="/images/warning.svg" class="sim-icon me-1" alt="" /> CTF Challenges (@Model.Challenges.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-inline-flex align-items-center gap-1" id="simulations-tab" data-bs-toggle="pill" data-bs-target="#simulations-content" type="button" role="tab">
                <img src="/images/terminal.svg" class="sim-icon me-1" alt="" /> Terminal Labs (@Model.SimulationTasks.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-inline-flex align-items-center gap-1" id="notebooks-tab" data-bs-toggle="pill" data-bs-target="#notebooks-content" type="button" role="tab">
                <img src="/images/notebook.svg" class="sim-icon me-1" alt="" /> Terminal Notebooks (@Model.CourseNotebooks.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-inline-flex align-items-center gap-1" id="students-tab" data-bs-toggle="pill" data-bs-target="#students-content" type="button" role="tab">
                <img src="/images/settings.svg" class="sim-icon me-1" alt="" /> Enrolled Students (@Model.EnrolledStudents.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="curriculumTabContent">
        <!-- 1. LESSONS TAB -->
        <div class="tab-pane fade show active" id="lessons-content" role="tabpanel">
            <div class="surface-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2>Theory &amp; Technical Lessons</h2>
                        <span class="text-secondary">Create structured reading material and multimedia tutorials</span>
                    </div>
                    <a asp-action="AddLesson" asp-route-courseId="@Model.Course.CourseId" class="btn btn-primary btn-sm">
                        + Add Lesson
                    </a>
                </div>

                @if (Model.Lessons.Count == 0)
                {
                    <div class="empty-state p-4 text-center">
                        <p class="text-secondary">No lessons in this course yet. Add your first lesson above.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle module-table">
                            <thead>
                                <tr>
                                    <th style="width: 5rem;">Order</th>
                                    <th>Lesson Title</th>
                                    <th>Media</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.Lessons)
                                {
                                    <tr>
                                        <td><strong>#@l.OrderIndex</strong></td>
                                        <td>
                                            <strong>@l.Title</strong>
                                            <div class="record-secondary">
                                                @(string.IsNullOrEmpty(l.Content) ? "No text" : (l.Content.Length > 80 ? l.Content.Substring(0, 80) + "..." : l.Content))
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(l.VideoUrl))
                                            {
                                                <span class="badge bg-info text-dark">Video Attached</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Text-only</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="EditLesson" asp-route-id="@l.LessonId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <form asp-action="DeleteLesson" asp-route-id="@l.LessonId" method="post" onsubmit="return confirm('Delete this lesson?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 2. CTF CHALLENGES TAB -->
        <div class="tab-pane fade" id="challenges-content" role="tabpanel">
            <div class="surface-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2>CTF Cybersecurity Challenges</h2>
                        <span class="text-secondary">Upload target artifacts/logs and set SHA-256 protected flags</span>
                    </div>
                    <a asp-action="AddChallenge" asp-route-courseId="@Model.Course.CourseId" class="btn btn-primary btn-sm">
                        + Add CTF Challenge
                    </a>
                </div>

                @if (Model.Challenges.Count == 0)
                {
                    <div class="empty-state p-4 text-center">
                        <p class="text-secondary">No CTF challenges created yet. Add a challenge to test learners' skills!</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle module-table">
                            <thead>
                                <tr>
                                    <th>Challenge Title</th>
                                    <th>Category</th>
                                    <th>Difficulty</th>
                                    <th>Points</th>
                                    <th>Artifact File</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ch in Model.Challenges)
                                {
                                    <tr>
                                        <td>
                                            <strong>@ch.Title</strong>
                                            <div class="record-secondary">@(ch.Description != null && ch.Description.Length > 60 ? ch.Description.Substring(0, 60) + "..." : ch.Description)</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@ch.Category</span></td>
                                        <td><span class="difficulty-badge diff-@ch.Difficulty?.ToLowerInvariant()">@ch.Difficulty</span></td>
                                        <td><strong>@ch.Points</strong> pts</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ch.FilePath))
                                            {
                                                <span class="text-success small d-inline-flex align-items-center gap-1">
                                                    <img src="/images/check.svg" class="sim-icon" alt="" style="width:13px;height:13px;" />
                                                    @System.IO.Path.GetFileName(ch.FilePath)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">None</span>
                                            }
                                        </td>
                                        <td>
                                            @if (ch.IsPublished)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Draft</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="EditChallenge" asp-route-id="@ch.ChallengeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <form asp-action="DeleteChallenge" asp-route-id="@ch.ChallengeId" method="post" onsubmit="return confirm('Delete this CTF challenge?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 3. SIMULATIONS TAB -->
        <div class="tab-pane fade" id="simulations-content" role="tabpanel">
            <div class="surface-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2>Simulated Terminal Lab Exercises</h2>
                        <span class="text-secondary">Configure virtual Linux file trees, allowed commands, and automated objectives</span>
                    </div>
                    <a asp-action="AddSimulation" asp-route-courseId="@Model.Course.CourseId" class="btn btn-primary btn-sm">
                        + Add Terminal Lab
                    </a>
                </div>

                @if (Model.SimulationTasks.Count == 0)
                {
                    <div class="empty-state p-4 text-center">
                        <p class="text-secondary">No terminal labs in this course yet. Create interactive terminal simulation labs above.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle module-table">
                            <thead>
                                <tr>
                                    <th>Lab Title</th>
                                    <th>Instructions</th>
                                    <th>Virtual Shell Config</th>
                                    <th>Reward Token</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.SimulationTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@s.Title</strong>
                                        </td>
                                        <td>
                                            <div class="record-secondary">@(s.Instructions != null && s.Instructions.Length > 70 ? s.Instructions.Substring(0, 70) + "..." : s.Instructions)</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark font-monospace">JSON Configured</span>
                                        </td>
                                        <td>
                                            <code class="small text-secondary">@(string.IsNullOrEmpty(s.RewardFlagHash) ? "None" : s.RewardFlagHash)</code>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="EditSimulation" asp-route-id="@s.TaskId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <form asp-action="DeleteSimulation" asp-route-id="@s.TaskId" method="post" data-confirm="Delete this simulation task? This action cannot be undone." data-confirm-title="Delete Simulation Lab?" data-confirm-button="Delete Lab" data-confirm-destructive="true">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 4. NOTEBOOKS TAB -->
        <div class="tab-pane fade" id="notebooks-content" role="tabpanel">
            <div class="surface-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2>Terminal Notebooks</h2>
                        <span class="text-secondary">Combine Markdown notes with interactive and static terminal demonstrations</span>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addNotebookModal">
                        + Add Notebook to Course
                    </button>
                </div>

                @if (Model.CourseNotebooks.Count == 0)
                {
                    <div class="empty-state p-4 text-center">
                        <p class="text-secondary">No terminal notebooks in this course yet. Add your first notebook above.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle module-table">
                            <thead>
                                <tr>
                                    <th style="width: 5rem;">Order</th>
                                    <th>Notebook Title</th>
                                    <th>Status</th>
                                    <th>Last Updated</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var nb in Model.CourseNotebooks)
                                {
                                    <tr>
                                        <td><span class="font-monospace">#@nb.OrderIndex</span></td>
                                        <td>
                                            <strong>@nb.Title</strong>
                                        </td>
                                        <td>
                                            @if (nb.IsPublished)
                                            {
                                                <span class="badge bg-success">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Draft</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-secondary small">@UserTime.Format(nb.UpdatedAtUtc)</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2 align-items-center">
                                                <a asp-action="EditCourseNotebook" asp-route-id="@nb.CourseNotebookId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <a asp-action="ExportCourseNotebook" asp-route-id="@nb.CourseNotebookId" class="btn btn-sm btn-outline-secondary" title="Export Standalone HTML">HTML</a>
                                                <form asp-action="ToggleCourseNotebookPublish" asp-route-id="@nb.CourseNotebookId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                        @(nb.IsPublished ? "Unpublish" : "Publish")
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteCourseNotebook" asp-route-id="@nb.CourseNotebookId" method="post" data-confirm="Delete this course notebook? Enrolled students will no longer see it." data-confirm-title="Delete Course Notebook?" data-confirm-button="Delete Notebook" data-confirm-destructive="true">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 5. STUDENTS TAB -->
        <div class="tab-pane fade" id="students-content" role="tabpanel">
            <div class="surface-panel p-4 mb-4">
                <h2>Enrolled Learners</h2>
                <p class="text-secondary mb-3">Monitor enrolled students, completion, and elapsed time from enrolment to their latest completed activity.</p>

                @if (Model.EnrolledStudents.Count == 0)
                {
                    <div class="empty-state p-4 text-center">
                        <p class="text-secondary">No students have enrolled in this course yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle module-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Enrolled Date</th>
                                    <th>Progress</th>
                                    <th>Course Time</th>
                                    <th>Latest Activity</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var st in Model.EnrolledStudents)
                                {
                                    <tr>
                                        <td>
                                            <strong>@st.StudentName</strong>
                                            <div class="record-secondary">@st.StudentEmail</div>
                                        </td>
                                        <td>@UserTime.Format(st.EnrolledDate, "dd MMM yyyy") (@UserTime.Id)</td>
                                        <td style="width: 14rem;">
                                            <div class="d-flex align-items-center gap-2">
                                                <progress value="@st.ProgressPercent" max="100" style="width:100px; height:6px;"></progress>
                                                <strong>@st.ProgressPercent%</strong>
                                            </div>
                                        </td>
                                        <td>@st.ElapsedCourseTimeLabel</td>
                                        <td>@(st.LatestActivityUtc.HasValue ? UserTime.Format(st.LatestActivityUtc.Value, "dd MMM yyyy, HH:mm") : "—")</td>
                                        <td>
                                            <span class="badge @(st.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                                @st.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Recent Flag Submissions in this Course -->
            @if (Model.RecentSubmissions.Any())
            {
                <div class="surface-panel p-4">
                    <h3>Recent CTF Submissions in Course</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Submitted Flag</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in Model.RecentSubmissions)
                                {
                                    <tr>
                                        <td>@UserTime.Format(sub.SubmittedDate)</td>
                                        <td><code>@sub.SubmittedFlag</code></td>
                                        <td>
                                            <span class="badge @(sub.IsCorrect ? "bg-success" : "bg-danger")">
                                                @(sub.IsCorrect ? "Correct" : "Incorrect")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Add Notebook to Course -->
<div class="modal fade" id="addNotebookModal" tabindex="-1" aria-labelledby="addNotebookModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddNotebookToCourse" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@Model.Course.CourseId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addNotebookModalLabel">Add Notebook to Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">
                        Adding a notebook creates an independent copy for this course. Any future edits to your personal notebook or course copy will remain isolated from each other.
                    </p>

                    @{
                        var pNotebooks = ViewBag.PersonalNotebooks as IEnumerable<dynamic>;
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Option A: Copy from Personal Notebooks</label>
                        <select name="SelectedNotebookId" class="form-select">
                            <option value="">-- Choose an existing personal notebook --</option>
                            @if (pNotebooks != null)
                            {
                                foreach (var pnb in pNotebooks)
                                {
                                    <option value="@pnb.NotebookId">@pnb.Title</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="text-center my-2 text-secondary fw-semibold small">— OR —</div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Option B: Create New Blank Course Notebook</label>
                        <input type="text" name="NewNotebookTitle" class="form-control" placeholder="e.g. Linux Command Walkthrough &amp; Notes" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add to Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/terminal-dialogs.js" asp-append-version="true"></script>
}
