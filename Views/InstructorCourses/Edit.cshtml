@model CourseCreateEditModel
@{
    ViewData["Title"] = "Edit Course Settings";
}

<div class="container module-shell">
    <div class="mb-3">
        <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary">← Back to Course Curriculum</a>
    </div>

    <div class="page-heading">
        <div>
            <h1>Edit Course Settings</h1>
            <p class="text-secondary">Update course details, title, and catalogue visibility.</p>
        </div>
    </div>

    <div class="surface-panel p-4" style="max-width: 44rem;">
        <form method="post" asp-action="Edit" data-validated-form>
            <input type="hidden" asp-for="CourseId" />

            <div asp-validation-summary="ModelOnly" class="validation-summary mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Course Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" required maxlength="150" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Domain / Category</label>
                <select asp-for="Category" class="form-select">
                    <option value="Web Security">Web Security</option>
                    <option value="Linux Basics">Linux Basics</option>
                    <option value="Cryptography">Cryptography</option>
                    <option value="Network Security">Network Security</option>
                    <option value="Digital Forensics">Digital Forensics</option>
                    <option value="Reverse Engineering">Reverse Engineering</option>
                    <option value="General Security">General Security</option>
                </select>
                <span asp-validation-for="Category" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Course Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ThumbnailUrl" class="form-label">Thumbnail URL (Optional)</label>
                <input asp-for="ThumbnailUrl" class="form-control" />
                <span asp-validation-for="ThumbnailUrl" class="field-error"></span>
            </div>

            @if (Model.ReviewStatus == CourseReviewStatus.Approved) {
                <div class="form-check mb-3"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Published in catalogue</label></div>
            }
            <span asp-validation-for="IsPublished" class="field-error"></span>
            <p class="text-secondary mb-4">Changing course details unpublishes the course and requires Admin review again. Publishing without changing approved content is allowed.</p>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
