
@model IEnumerable<HackAcad.Web.Models.Entities.CourseReviewHistory>

@{
    ViewData["Title"] = "Course Review Timeline";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Course Review Timeline</h2>
            <p class="text-muted">
                Review history for: @ViewBag.Course?.Title
            </p>
        </div>

        <a asp-action="Curriculum" class="btn btn-secondary">
            Back to Curriculum
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No review history is available for this course yet.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item mb-2">
                    <h5 class="mb-1">@item.Action</h5>

                    <p class="mb-1">
                        @(string.IsNullOrWhiteSpace(item.Remarks)
                            ? "No remarks"
                            : item.Remarks)
                    </p>

                    <small class="text-muted">
                        Performed by: @item.PerformedBy
                        <br />
                        Date: @item.PerformedAtUtc.ToLocalTime()
                    </small>
                </div>
            }
        </div>
    }
</div>
