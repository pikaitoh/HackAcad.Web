@model SimulationCreateEditModel
@{
    var isEdit = Model.TaskId > 0;
    ViewData["Title"] = isEdit ? "Edit Terminal Lab" : "Add Terminal Lab";
}

<div class="container module-shell">
    <div class="mb-3">
        <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary">← Back to Curriculum</a>
    </div>

    <div class="page-heading">
        <div>
            <h1>@(isEdit ? "Edit Terminal Lab Exercise" : "Add New Terminal Lab Exercise")</h1>
            <p class="text-secondary">Configure simulated Linux filesystem, pre-defined allowed commands, and automated task objectives.</p>
        </div>
    </div>

    <div class="surface-panel p-4" style="max-width: 52rem;">
        <form method="post" asp-action="SaveSimulation" data-validated-form>
            <input type="hidden" asp-for="TaskId" />
            <input type="hidden" asp-for="CourseId" />

            <div asp-validation-summary="ModelOnly" class="validation-summary mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Lab Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Linux Command Line Exploration & Secret Audit" required maxlength="150" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Instructions" class="form-label">Learner Instructions &amp; Objectives Description</label>
                <textarea asp-for="Instructions" class="form-control" rows="3" placeholder="Instruct the student on what they are supposed to accomplish in the simulated terminal..."></textarea>
                <span asp-validation-for="Instructions" class="field-error"></span>
            </div>

            <!-- Template Preset Selector -->
            <div class="mb-3 p-3" style="background:var(--ha-tint); border-radius:8px;">
                <label class="form-label mb-1"><strong>Quick Lab Template Preset</strong></label>
                <div class="d-flex gap-2 align-items-center">
                    <select id="templateSelector" class="form-select form-select-sm" style="max-width:24rem;">
                        <option value="">-- Choose a Pre-configured Lab Template --</option>
                        <option value="linux_basics">Linux Basics (cd, ls, cat secret file)</option>
                        <option value="recon_web">Web Recon Lab (nmap, curl debug endpoint)</option>
                        <option value="chmod_permissions">Permission Audit Lab (chmod, inspect audit.sh)</option>
                        <option value="crypto_base64">Encoding &amp; Decoding (base64 token extraction)</option>
                    </select>
                    <button type="button" id="applyTemplateBtn" class="btn btn-sm btn-outline-secondary">Apply Template</button>
                </div>
                <div class="form-text">Selecting a preset automatically generates realistic virtual directories, files, allowed commands, and objective verification rules below.</div>
            </div>

            <!-- Virtual File System JSON -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="VirtualFileSystemJson" class="form-label mb-0">Virtual Environment Configuration (JSON)</label>
                    <span class="text-muted small">Configures NetAcad allowed commands &amp; virtual file tree</span>
                </div>
                <textarea asp-for="VirtualFileSystemJson" id="vfsJson" class="form-control font-monospace" rows="14" spellcheck="false"></textarea>
                <div class="form-text">
                    Specify <code>allowedCommands</code> array to restrict user actions, <code>fileSystem</code> object for files and folders, and <code>objectives</code> for automated step verification.
                </div>
                <span asp-validation-for="VirtualFileSystemJson" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RewardFlag" class="form-label">Reward Flag (Revealed upon completing all objectives)</label>
                <input asp-for="RewardFlag" class="form-control font-monospace" placeholder="flag{...}" />
                <div class="form-text">This token is shown to the student upon completing all lab steps.</div>
                <span asp-validation-for="RewardFlag" class="field-error"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedCheck" />
                <label class="form-check-label" for="isPublishedCheck">
                    <strong>Published in course curriculum</strong>
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Simulation Lab</button>
                <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const templates = {
        linux_basics: {
            allowedCommands: ["help", "clear", "pwd", "ls", "cd", "cat", "grep", "whoami"],
            initialDirectory: "/home/student",
            fileSystem: {
                home: {
                    student: {
                        "notes.txt": "Target token is stored inside /var/secret/access.token.",
                        "welcome.txt": "Welcome to Linux Fundamentals lab."
                    }
                },
                var: {
                    secret: {
                        "access.token": "flag{l1nux_n4v1g4t10n_succ3ss}"
                    }
                }
            },
            objectives: [
                { id: "nav_var", text: "Navigate to /var/secret directory", type: "cwd", target: "/var/secret" },
                { id: "read_token", text: "View access.token using cat", type: "cat", target: "access.token" }
            ]
        },
        recon_web: {
            allowedCommands: ["help", "clear", "ping", "nmap", "curl", "whoami"],
            initialDirectory: "/home/student",
            fileSystem: {
                home: {
                    student: {
                        "targets.txt": "Target host: target.hackacad.local\nPort 8080 hosts debug API."
                    }
                }
            },
            objectives: [
                { id: "scan_target", text: "Run nmap scan on target", type: "command", target: "nmap" },
                { id: "curl_endpoint", text: "Query debug endpoint with curl", type: "command", target: "curl" }
            ]
        },
        chmod_permissions: {
            allowedCommands: ["help", "clear", "pwd", "ls", "cd", "cat", "chmod", "whoami"],
            initialDirectory: "/home/student",
            fileSystem: {
                home: {
                    student: {
                        "audit.sh": "#!/bin/bash\necho 'Key: flag{chm0d_p3rm1ss10n_m4st3r}'"
                    }
                }
            },
            objectives: [
                { id: "chmod_step", text: "Grant execution permissions using chmod 755 audit.sh", type: "chmod", target: "audit.sh" },
                { id: "read_audit", text: "Read the audit.sh script with cat", type: "cat", target: "audit.sh" }
            ]
        },
        crypto_base64: {
            allowedCommands: ["help", "clear", "ls", "cat", "base64", "echo"],
            initialDirectory: "/home/student",
            fileSystem: {
                home: {
                    student: {
                        "encoded.txt": "ZmxhZ3tiYXNlNjRfZDNjMGQzZF9mdW5kYW1lbnRhbHN9"
                    }
                }
            },
            objectives: [
                { id: "cat_encoded", text: "Inspect encoded.txt with cat", type: "cat", target: "encoded.txt" },
                { id: "decode_b64", text: "Decode the base64 token using base64 -d", type: "command", target: "base64" }
            ]
        }
    };

    document.getElementById('applyTemplateBtn')?.addEventListener('click', function () {
        const sel = document.getElementById('templateSelector').value;
        if (sel && templates[sel]) {
            document.getElementById('vfsJson').value = JSON.stringify(templates[sel], null, 2);
        }
    });
</script>
}
