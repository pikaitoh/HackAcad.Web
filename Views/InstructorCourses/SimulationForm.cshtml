@model SimulationCreateEditModel
@{
    var isEdit = Model.TaskId > 0;
    ViewData["Title"] = isEdit ? "Visual Simulation Builder — Edit Lab" : "Visual Simulation Builder — New Lab";
}

<link rel="stylesheet" href="~/css/learning.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/simulation-builder.css" asp-append-version="true" />

<div class="container module-shell" style="max-width: 1200px;">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary">← Back to Course Curriculum</a>
        <span class="badge @(Model.IsPublished ? "bg-success" : "bg-warning text-dark")">
            @(Model.IsPublished ? "Published in Curriculum" : "Draft (Unpublished)")
        </span>
    </div>

    <div class="page-heading mb-4">
        <div>
            <h1>@(isEdit ? "Visual Simulation Builder — Edit Lab" : "Visual Simulation Builder — Create Lab")</h1>
            <p class="text-secondary">
                Design custom NetAcad-style terminal simulation labs. Build virtual Linux filesystems, configure allowed shell commands, and define automated step objectives.
            </p>
        </div>
    </div>

    <!-- Hidden Form submitting to SaveSimulation action -->
    <form method="post" asp-action="SaveSimulation" id="simulationForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TaskId" id="TaskId" />
        <input type="hidden" asp-for="CourseId" id="CourseId" />
        <input type="hidden" asp-for="Title" id="Title" />
        <input type="hidden" asp-for="Description" id="Description" />
        <input type="hidden" asp-for="Difficulty" id="Difficulty" />
        <input type="hidden" asp-for="Instructions" id="Instructions" />
        <input type="hidden" asp-for="RewardFlag" id="RewardFlag" />
        <input type="hidden" asp-for="IsPublished" id="isPublishedCheck" />
        <input type="hidden" asp-for="VirtualFileSystemJson" id="VirtualFileSystemJson" />

        <div asp-validation-summary="All" class="validation-summary mb-3" role="alert"></div>

        <!-- Mount point for Visual Simulation Builder -->
        <div id="simulation-builder-mount"></div>
    </form>
</div>

@section Scripts {
    <script src="~/js/simulation-terminal.js" asp-append-version="true"></script>
    <script src="~/js/simulation-builder.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.initSimulationBuilder({
                containerId: "simulation-builder-mount",
                formId: "simulationForm",
                hiddenJsonInputId: "VirtualFileSystemJson",
                cancelUrl: "@Url.Action("Curriculum", new { id = Model.CourseId })",
                initialTitle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title ?? "")),
                initialDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Description ?? "")),
                initialDifficulty: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Difficulty ?? "Beginner")),
                initialInstructions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Instructions ?? "")),
                initialRewardFlag: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RewardFlag ?? "")),
                initialIsPublished: @(Model.IsPublished ? "true" : "false")
            });
        });
    </script>
}
