
@model ChallengeCreateEditModel
@{
    var isEdit = Model.ChallengeId > 0;
    ViewData["Title"] = isEdit ? "Edit CTF Challenge" : "Add CTF Challenge";
}

<div class="container module-shell">
    <div class="mb-3">
        <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary">← Back to Curriculum</a>
    </div>

    <div class="page-heading">
        <div>
            <h1>@(isEdit ? "Edit CTF Challenge" : "Add New CTF Challenge")</h1>
            <p class="text-secondary">Attach downloadable evidence or scenario files and define the target flag.</p>
        </div>
    </div>

    <div class="surface-panel p-4" style="max-width: 48rem;">
        <form method="post" asp-action="SaveChallenge" enctype="multipart/form-data" data-validated-form>
            <input type="hidden" asp-for="ChallengeId" />
            <input type="hidden" asp-for="CourseId" />

            <div asp-validation-summary="All" class="validation-summary mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Challenge Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Insecure Direct Object Reference" required maxlength="150" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label">Category <span class="text-danger">*</span></label>
                    <select asp-for="Category" class="form-select">
                        <option value="Web">Web Application Security</option>
                        <option value="Crypto">Cryptography</option>
                        <option value="Forensics">Digital Forensics &amp; Logs</option>
                        <option value="Network">Network Security &amp; Recon</option>
                        <option value="Reverse">Reverse Engineering</option>
                        <option value="Misc">Miscellaneous</option>
                    </select>
                    <span asp-validation-for="Category" class="field-error"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Difficulty" class="form-label">Difficulty <span class="text-danger">*</span></label>
                    <select asp-for="Difficulty" class="form-select">
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                        <option value="Insane">Insane</option>
                    </select>
                    <span asp-validation-for="Difficulty" class="field-error"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Points" class="form-label">Points Awarded <span class="text-danger">*</span></label>
                    <input asp-for="Points" type="number" class="form-control" min="10" max="1000" step="10" required />
                    <span asp-validation-for="Points" class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Challenge Mission / Problem Statement</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the scenario, what learners should investigate..."></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <!-- Secret Flag -->
            <div class="mb-3">
                <label asp-for="PlaintextFlag" class="form-label">
                    Secret Flag @(isEdit ? "(Leave blank to keep existing secret flag)" : "")
                    @if (!isEdit)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                <input asp-for="PlaintextFlag" class="form-control font-monospace" placeholder="flag{example_cyber_token_123}" />
                <div class="form-text">
                    🔒 Security: Plaintext flags are never stored in the database. The server immediately calculates a cryptographic SHA-256 hash.
                </div>
                <span asp-validation-for="PlaintextFlag" class="field-error"></span>
            </div>

            <!-- File Upload -->
            <div class="mb-3">
                <label asp-for="UploadFile" class="form-label">Challenge Evidence / Artifact File (Optional)</label>
                <input asp-for="UploadFile" type="file" class="form-control" />
                <input type="hidden" id="PreviewFileName" name="PreviewFileName" />
                <div class="form-text">Upload a PCAP capture, log file, binary, source code, or ZIP archive students will download to solve offline.</div>

                @if (!string.IsNullOrEmpty(Model.ExistingFilePath))
                {
                    <div class="mt-2 text-success small">
                        Current file attached: <strong>@System.IO.Path.GetFileName(Model.ExistingFilePath)</strong>
                    </div>
                }
            </div>

            <hr class="my-4" />

            <!-- Hint Management -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h4 class="mb-1">Challenge Hints</h4>
                        <p class="text-secondary small mb-0">
                            Add optional clues that learners can unlock in sequence. Each hint has its own point deduction.
                        </p>
                    </div>
                    <button type="button" id="addHintBtn" class="btn btn-outline-primary btn-sm">
                        + Add Hint
                    </button>
                </div>

                <div id="hintsContainer">
                    @for (var i = 0; i < Model.Hints.Count; i++)
                    {
                        <div class="hint-row border rounded p-3 mb-3">
                            <input type="hidden" name="Hints[@i].ChallengeHintId" value="@Model.Hints[i].ChallengeHintId" />

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="hint-heading">Hint @(i + 1)</strong>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-hint-btn">Remove</button>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Hint Text</label>
                                <textarea name="Hints[@i].HintText" class="form-control" rows="3" maxlength="2000" required>@Model.Hints[i].HintText</textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Display Order</label>
                                    <input name="Hints[@i].DisplayOrder" type="number" class="form-control hint-order" min="1" max="100" value="@(i + 1)" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Point Deduction</label>
                                    <input name="Hints[@i].DeductionPoints" type="number" class="form-control" min="0" max="1000" value="@Model.Hints[i].DeductionPoints" required />
                                    <div class="form-text">Points deducted when this hint is unlocked.</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div id="noHintsMessage" class="text-secondary small border rounded p-3">
                    No hints added yet. Click "Add Hint" to create the first hint.
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedCheck" />
                <label class="form-check-label" for="isPublishedCheck">
                    <strong>Published in course curriculum</strong>
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="button" id="previewChallengeBtn" class="btn btn-outline-primary">
                    Preview Challenge
                </button>

                <button type="submit" class="btn btn-primary">Save CTF Challenge</button>

                <a asp-action="Curriculum" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Hint management
        const hintsContainer = document.getElementById("hintsContainer");
        const addHintBtn = document.getElementById("addHintBtn");
        const noHintsMessage = document.getElementById("noHintsMessage");

        function updateHintRows() {
            const rows = hintsContainer.querySelectorAll(".hint-row");

            rows.forEach((row, index) => {
                row.querySelector(".hint-heading").textContent = `Hint ${index + 1}`;

                row.querySelectorAll("input, textarea").forEach(input => {
                    const property = input.name.split(".").pop();
                    input.name = `Hints[${index}].${property}`;
                });

                const orderInput = row.querySelector(".hint-order");
                orderInput.value = index + 1;
            });

            noHintsMessage.style.display = rows.length === 0 ? "block" : "none";
        }

        function addHint() {
            const index = hintsContainer.querySelectorAll(".hint-row").length;

            const row = document.createElement("div");
            row.className = "hint-row border rounded p-3 mb-3";

            row.innerHTML = `
                <input type="hidden" name="Hints[${index}].ChallengeHintId" value="0" />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="hint-heading">Hint ${index + 1}</strong>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-hint-btn">Remove</button>
                </div>

                <div class="mb-3">
                    <label class="form-label">Hint Text</label>
                    <textarea name="Hints[${index}].HintText" class="form-control" rows="3" maxlength="2000" required></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Display Order</label>
                        <input name="Hints[${index}].DisplayOrder" type="number" class="form-control hint-order" min="1" max="100" value="${index + 1}" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Point Deduction</label>
                        <input name="Hints[${index}].DeductionPoints" type="number" class="form-control" min="0" max="1000" value="10" required />
                        <div class="form-text">Points deducted when this hint is unlocked.</div>
                    </div>
                </div>
            `;

            hintsContainer.appendChild(row);
            updateHintRows();
        }

        addHintBtn.addEventListener("click", addHint);

        hintsContainer.addEventListener("click", function (event) {
            if (event.target.classList.contains("remove-hint-btn")) {
                event.target.closest(".hint-row").remove();
                updateHintRows();
            }
        });

        updateHintRows();

            // Preview challenge
            document.getElementById("previewChallengeBtn").addEventListener("click", function () {
                const form = this.closest("form");
                const fileInput = form.querySelector('[name="UploadFile"]');
                const previewFileName = form.querySelector('[name="PreviewFileName"]');

                if (fileInput.files.length > 0) {
                    previewFileName.value = fileInput.files[0].name;
                } else {
                    previewFileName.value = "";
                }

                const previewForm = document.createElement("form");
                previewForm.method = "POST";
                previewForm.action = "/InstructorCourses/PreviewChallenge";
                previewForm.target = "_blank";

                // Copy every successful form field, including all hint fields.
                const formData = new FormData(form);

                for (const [name, value] of formData.entries()) {
                    // Do not upload the actual file during preview.
                    if (name === "UploadFile") continue;

                    // PreviewFileName is handled separately below.
                    if (name === "PreviewFileName") continue;

                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = name;
                    input.value = value;
                    previewForm.appendChild(input);
                }

                const fileNameInput = document.createElement("input");
                fileNameInput.type = "hidden";
                fileNameInput.name = "PreviewFileName";
                fileNameInput.value = previewFileName.value;
                previewForm.appendChild(fileNameInput);

                document.body.appendChild(previewForm);
                previewForm.submit();
                previewForm.remove();
            });

    </script>
}