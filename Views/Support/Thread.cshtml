@model SupportThreadModel
@{ ViewData["Title"] = $"Support request #{Model.Ticket.Id}"; }
<div class="page-heading"><div><h1>@Model.Ticket.Subject</h1><p class="text-secondary">Request #@Model.Ticket.Id · Times shown in @UserTime.Id.</p></div><span class="support-status" data-status="@Model.Ticket.Status">@Model.Ticket.Status</span></div>
<section class="surface-panel"><h2 class="h5">Conversation</h2><partial name="_SupportMessages" model="Model.Messages" /></section>
<section class="surface-panel mt-4"><h2 class="h5">@(Model.Ticket.Status == "Resolved" ? "Need more help?" : "Reply to the administrator")</h2>
@if (Model.Ticket.Status == "Resolved") { <p>Sending another message reopens this request for review.</p> }
<form asp-action="Reply" asp-route-id="@Model.Ticket.Id" method="post" data-validated-form novalidate><input type="hidden" name="Version" value="@Model.Ticket.Version" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<label for="Body" class="form-label">Message</label><textarea id="Body" name="Body" class="form-control" rows="5" required minlength="10" maxlength="3000" aria-describedby="reply-help">@Model.Input.Body</textarea><p id="reply-help" class="form-text">10–3,000 characters. Do not include passwords or verification codes.</p><button class="btn btn-primary">Send reply</button></form></section>
