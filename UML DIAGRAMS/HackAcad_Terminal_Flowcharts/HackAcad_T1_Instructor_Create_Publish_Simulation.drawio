        </mxCell>
        <mxCell id="n2" value="Open Instructor Studio, choose one of your courses and open its Terminal Labs tab" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="238" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Click Add Simulation&lt;br&gt;(/InstructorCourses/AddSimulation)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
