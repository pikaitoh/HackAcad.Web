        <mxCell id="n1" value="Sign in as an Instructor&lt;br&gt;Follow (GA5) and (GA11)" style="shape=process;backgroundOutline=1;size=0.06;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
