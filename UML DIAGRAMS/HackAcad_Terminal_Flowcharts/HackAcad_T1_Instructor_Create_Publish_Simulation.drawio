          <mxGeometry x="720" y="544" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Show the Visual Simulation Builder (a sample lab for a new task, or the saved task when editing)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="574" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="1. Set the lab details: title, description, difficulty, student instructions and optional reward flag" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="676" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="2. Build the virtual Linux filesystem: add, rename or delete folders and files, edit file contents and choose the starting directory" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="778" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="3. Choose the allowed built-in commands (help and clear are always on)&lt;br&gt;4. Add exact-match custom commands with their output and optional required files or folders" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="880" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="5. Define the objectives: expected command, optional execution directory, hint, and whether steps must be completed in order" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="1012" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Optional: test the lab in the Live Preview tab (runs in the browser, nothing is saved)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="1134" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Publish the lab or save it as a draft?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1;" parent="1" vertex="1">
